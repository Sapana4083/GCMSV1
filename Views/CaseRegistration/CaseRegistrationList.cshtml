@{
    ViewData["Title"] = "Case Registration List";
}

<!-- ========== PAGE CONTAINER ========== -->
<div class="container-fluid bg-light rounded-4 m-auto shadow py-4 px-3">
    @Html.AntiForgeryToken()
    <!-- Header -->
    <div class="d-flex justify-content-between mb-3 border-bottom border-3 pb-3">

        <h4>Case Registration List</h4>

        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "CaseRegistration")" class="btn btn-primary" title="Click to add new case.">
                Add Case Registration
            </a>
            <button type="button" class="btn btn-secondary" id="btnPrint" title="Click to print.">
                <i class="bi bi-printer-fill"></i>
            </button>
            <button type="button" class="btn btn-success" id="btnExcel" title="Click to download excel.">
                <i class="bi bi-file-earmark-excel"></i>
            </button>
        </div>

    </div>
    <div class="table-responsive">
        <!-- Data Table -->
        <table id="tblCaseRegistration" class="table table-bordered table-striped">

            <thead>
                <tr>
                    <th>S. No.</th>
                    <th>Case No</th>
                    <th>Institution Date</th>
                    <th>Case Type</th>
                    <th>Case Subject</th>
                    <th>Case Purpose</th>
                    <th>Hearing Date</th>
                    <th>Bench Type</th>
                    <th>Created By</th>
                    <th>Modified Date</th>
                    <th width="100">Action</th>
                </tr>
            </thead>

            <tbody></tbody>

        </table>
    </div>
</div>


<!-- ========== SCRIPTS ========== -->
@section Scripts {
    <script>

        var token = $('input[name="__RequestVerificationToken"]').val();

        // ── Init — Server-Side DataTable ──────────────────────
        $(document).ready(function() {

            $('#tblCaseRegistration').DataTable({

                dom: 'lBfrtip',

                processing: true,
                serverSide: true,     // ✅ dynamic pagination server se

                responsive: true,
                autoWidth: false,

                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],

                paging: true,
                searching: true,     // server-side search abhi disable (SP support nahi karta)
                ordering: false,      // server-side sort SP me implement nahi hai
                info: true,

                ajax: {
                    url: '/CaseRegistration/GetCaseRegistrationListData',
                    type: 'POST',
                    data: function(d) {
                        d.__RequestVerificationToken = token;
                    }
                },

                columns: [
                    {
                        data: null,
                        render: function(data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    { data: 'mCaseNoo' },
                    {
                        data: 'institutionDate',
                        render: function(data) {
                            return data ? new Date(data).toLocaleDateString('en-GB') : '';
                        }
                    },
                    { data: 'caseType' },
                    { data: 'caseSubject' },
                    { data: 'casePurposeName' },
                    {
                        data: 'hearingDate',
                        render: function(data) {
                            return data ? new Date(data).toLocaleDateString('en-GB') : '';
                        }
                    },
                    { data: 'benchType' },
                    { data: 'createdBy' },
                    { data: 'modifiedOn' },
                    {
                        data: 'recordId',
                        render: function(data) {
                            return '<a href="/CaseRegistration/Index?id=' + data +
                                '" class="btn btn-default waves-effect waves-light" title="Click to edit record.">' +
                                '<i class="bi bi-pencil-square"></i></a>';
                        }
                    }
                ],

                buttons: [{
                    extend: 'print',
                    title: 'Case Registration List'
                },
                {
                    extend: 'excelHtml5',
                    title: 'Case Registration List'
                }
                ]
            });

            $('.dt-buttons').hide();
        });

        $("#btnPrint").click(function() {
            window.print();
        });

        $("#btnExcel").click(function() {
            let table = document.getElementById("tblCaseRegistration");
            let html = table.outerHTML;
            let url = 'data:application/vnd.ms-excel,' + encodeURIComponent(html);
            let a = document.createElement('a');
            a.href = url;
            a.download = 'CaseRegistrationList.xls';
            a.click();
        });

    </script>
}