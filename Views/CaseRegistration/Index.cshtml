        @section Scripts {

            <partial name="_ValidationScriptsPartial" />

            <script>
                $(document).ready(function() {
                    function showStep(step) {
                        $(".step-panel").removeClass("active");
                        $("#step" + step).addClass("active");

                        $(".wizard-step").removeClass("active");
                        $("#wizard" + step).addClass("active");
                    }

                    function value(name) {
                        return $("[name='" + name + "']").val();
                    }

                    function isChecked(name) {
                        return $("[name='" + name + "']").is(":checked");
                    }

                    function alertRequired(message) {
                        alert(message);
                        return false;
                    }

                    function validateStep1() {
                        if (!value("InstitutionDate")) return alertRequired("Please enter Institution Date.");
                        if (!value("CaseNumber")) return alertRequired("Please enter Case Number.");
                        if (!value("CaseTypeId")) return alertRequired("Please select Case Type.");
                        if (!value("CaseSubjectId")) return alertRequired("Please select Case Subject.");
                        if (!value("CasePurposeId")) return alertRequired("Please select Case Purpose.");
                        if (!value("HearingDate")) return alertRequired("Please enter Hearing Date.");
                        if (!value("BenchTypeId")) return alertRequired("Please select Bench Type.");

                        var caseNo = value("CaseNumber");
                        if (caseNo.length !== 10 || caseNo.indexOf("/") === -1) {
                            return alertRequired("Please enter valid Case Number. Format should be 12345/2026.");
                        }

                        var parts = caseNo.split("/");
                        if (parts[0].length !== 5 || parts[1].length !== 4) {
                            return alertRequired("Please enter valid Case Number. Format should be 12345/2026.");
                        }

                        if (isChecked("IsImpungned") && !value("DateofImpugnedOrder")) {
                            return alertRequired("Please enter Date of Impugned Order.");
                        }

                        if (value("DateofImpugnedOrder") && value("InstitutionDate")) {
                            if (new Date(value("DateofImpugnedOrder")) > new Date(value("InstitutionDate"))) {
                                return alertRequired("Date of Impugned Order cannot be greater than Institution Date.");
                            }
                        }

                        if (value("InstitutionDate") && value("HearingDate")) {
                            if (new Date(value("InstitutionDate")) > new Date(value("HearingDate"))) {
                                return alertRequired("Hearing Date must be greater than or equal to Institution Date.");
                            }
                        }

                        return true;
                    }

                    function validateStep2() {
                        if (!value("AppellantName")) return alertRequired("Please enter Appellant Name.");
                        if (!value("DesignationId")) return alertRequired("Please select Appellant Designation.");
                        if (!value("DistrictId")) return alertRequired("Please select Appellant District.");

                        var mobile = value("MobileNumber");
                        if (mobile && mobile.length !== 10) return alertRequired("Please enter valid Appellant Mobile Number.");

                        var advMobile = value("AdvocateMobile");
                        if (advMobile && advMobile.length !== 10) return alertRequired("Please enter valid Appellant Advocate Mobile Number.");

                        return true;
                    }

                    function validateStep3() {
                        if (!value("DepartmentId")) return alertRequired("Please select Respondent Department.");

                        var respMobile = value("RespondentAdvocateMobile");
                        if (respMobile && respMobile.length !== 10) {
                            return alertRequired("Please enter valid Respondent Advocate Mobile Number.");
                        }

                        return true;
                    }

                    $("#DepartmentId").on("change", function() {

                        var departmentId = $(this).val();

                        var respondentDropdown = $("#RespondentAdvocateId");

                        respondentDropdown.empty();
                        respondentDropdown.append(
                            '<option value="">Select Respondent Advocate</option>'
                        );

                        if (!departmentId) {
                            console.log("No department selected");
                            return;
                        }

                        $.ajax({
                            url: '@Url.Action("GetRespondentAdvocates", "CaseRegistration")',
                            type: 'GET',
                            data: {
                                departmentId: departmentId
                            },

                            beforeSend: function() {
                                console.log("Calling Controller...");
                            },

                            success: function(response) {

                                console.log("Controller Response:", response);

                                if (!isSuccess(response)) {
                                    alert(getMessage(response));
                                    return;
                                }

                                var data = getResponseValue(
                                    response,
                                    "data",
                                    "Data"
                                );

                                console.log("Advocate Data:", data);

                                if (!data || data.length === 0) {
                                    respondentDropdown.append(
                                        '<option value="">No Advocate Found</option>'
                                    );
                                    return;
                                }

                                $.each(data, function(index, advocate) {

                                    console.log("Advocate:", advocate);

                                    var advocateId = getResponseValue(
                                        advocate,
                                        "mastRcsatAdvocateId",
                                        "mastRcsatAdvocateId"
                                    );

                                    var advocateName = getResponseValue(
                                        advocate,
                                        "advEngHi",
                                        "advEngHi"
                                    );

                                    respondentDropdown.append(
                                        $("<option></option>")
                                            .val(advocateId)
                                            .text(advocateName)
                                    );
                                });
                            },

                            error: function(xhr, status, error) {

                                console.log("AJAX Error");
                                console.log("Status:", status);
                                console.log("Error:", error);
                                console.log("Response:", xhr.responseText);

                                alert("Unable to load Respondent Advocates.");
                            }
                        });
                    });

                    function getResponseValue(response, camelCaseName, pascalCaseName) {
                        return response[camelCaseName] !== undefined
                            ? response[camelCaseName]
                            : response[pascalCaseName];
                    }

                    function isSuccess(response) {
                        return getResponseValue(response, "success", "Success") === true;
                    }

                    function getMessage(response) {
                        return getResponseValue(response, "message", "Message") || "Unable to process request.";
                    }

                    $("#btnStep1").click(function() {
                                if (validateStep1()) showStep(2);
                    });

                    $("#btnStep2").click(function() {
                                if (validateStep2()) showStep(3);
                    });

                    $("#btnStep3").click(function() {
                                if (validateStep3()) showStep(4);
                    });

                    $("#btnFinish").click(function() {
                        if (!validateStep1() || !validateStep2() || !validateStep3()) {
                            return;
                        }

                        $.ajax({
                            url: "/CaseRegistration/SaveFullCaseRegistration",
                            type: "POST",
                            data: $("#frmCaseRegistration").serialize(),
                            success: function(res) {
                                if (isSuccess(res)) {
                                    alert(getMessage(res));
                                    window.location.href = "/CaseRegistration/Index";
                                } else {
                                    alert(getMessage(res));
                                }
                            },
                            error: function() {
                                alert("Server Error");
                            }
                        });
                    });

                    $("#btnBack1").click(function() { showStep(1); });
                    $("#btnBack2").click(function() { showStep(2); });
                    $("#btnBack3").click(function() { showStep(3); });
                });

                //Private Party

                    function buildPrivatePartyRow(index) {
                        var rowNumber = index + 1;
                        var advocateOptions = $("#privatePartyRows select:first").html() || '<option value="">Select Advocate</option>';

                        return '<tr>'
                            + '<td><input type="checkbox" class="row-check private-party-select" /></td>'
                            + '<td class="serial-cell">' + rowNumber + '</td>'
                            + '<td><input name="PrivateParties[' + index + '].PartyName" class="form-control" /></td>'
                                + '<td><input name="PrivateParties[' + index + '].Designation" class="form-control" /></td>'
                            + '<td><select name="PrivateParties[' + index + '].AdvocateId" class="form-select">' + advocateOptions + '</select></td>'
                            + '</tr>';
                    }

                    function refreshPrivatePartyRows() {
                        $("#privatePartyRows tr").each(function (index) {
                            $(this).find(".serial-cell").text(index + 1);
                                $(this).find("input[name$='.PartyName']").attr("name", "PrivateParties[" + index + "].PartyName");
                            $(this).find("input[name$='.Designation']").attr("name", "PrivateParties[" + index + "].Designation");
                            $(this).find("select[name$='.AdvocateId']").attr("name", "PrivateParties[" + index + "].AdvocateId");
                        });
                        }

                    $("#btnAddPrivateParty").click(function () {
                        $("#privatePartyRows").append(buildPrivatePartyRow($("#privatePartyRows tr").length));
                        });

                    $("#chkAllPrivateParties").change(function () {
                        $(".private-party-select").prop("checked", $(this).prop("checked"));
                        });

                    $("#btnDeletePrivateParty").click(function () {
                        var selectedRows = $("#privatePartyRows .private-party-select:checked").closest("tr");

                        if (selectedRows.length === 0) {
                            return;
                            }

                        if ($("#privatePartyRows tr").length === selectedRows.length) {
                            selectedRows.not(":first").remove();
                            selectedRows.first().find("input, select").val("");
                            selectedRows.first().find(".private-party-select").prop("checked", false);
                        }
                        else {
                            selectedRows.remove();
                        }

                        $("#chkAllPrivateParties").prop("checked", false);
                        refreshPrivatePartyRows();
                    });


            </script>

        }
