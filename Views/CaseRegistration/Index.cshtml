<style>

    body {
        background: #f5f7fb;
    }

    .wizard {
        display: flex;
        justify-content: space-between;
        margin-bottom: 25px;
        margin-left: 20px;
    }

    .wizard-step {
        flex: 1;
        text-align: center;
        padding: 14px;
        /* background: #ececec; */
        background: #dbf0ff;
        margin-right: 5px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 12px;
    }

        .wizard-step.active {
            /* background: #0d6efd; */
            background: #437fa9;
            color: white;
            margin-top: 12px;
        }

    .step-panel {
        display: none;
    }

        .step-panel.active {
            display: block;
        }

    .card {
        border: none;
        box-shadow: 0 2px 10px rgba(0, 0, 0, .08);
        margin-left: 20px;
        margin-right: 10px;
    }

    .card-header {
        /* background: #0d6efd; */
        background: #5097c9;
        color: white;
        font-size: 18px;
        font-weight: 600;
    }

    .required {
        color: red;
    }

    .save-btn-container {
        position: fixed;
        right: 65px;
        z-index: 999;
    }

    .btn-save-next {
        width: 190px;
        height: 40px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 10px;
        box-shadow: 0 4px 12px rgba(0,0,0,.2);
    }

</style>
