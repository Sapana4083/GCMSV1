@model List<GCMS.Models.ViewModels.CauseListParamsListItem>

@{
    ViewData["Title"] = "Cause List Configuration";
    var srNo = 1;
}

<!-- ========== PAGE CONTAINER ========== -->
<div class="container-fluid bg-light rounded-4 m-auto shadow mt-3 py-4 px-3">

    <!-- Header -->
    <div class="d-flex justify-content-between mb-3 border-bottom border-3 pb-3">

        <h4>Cause List Configuration</h4>

        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "CauseListConfiguration")" class="btn btn-primary" title="Click to add new configuration.">
                Add Cause List
            </a>
            <button type="button" class="btn btn-secondary" id="btnPrint" title="Click to print.">
                <i class="bi bi-printer-fill"></i>
            </button>
            <button type="button" class="btn btn-success" id="btnExcel" title="Click to download excel.">
                <i class="bi bi-file-earmark-excel"></i>
            </button>
        </div>

    </div>
    <div class="table-responsive">
        <!-- Data Table -->
        <table id="tblCauseList" class="table table-bordered table-striped">

            <thead>
                <tr>
                    <td width="50">S. No.</td>
                    <th>CLP No</th>
                    <th>Remarks</th>
                    <th>Cause List Type</th>
                    <th>Case Count Limit</th>
                    <th>Active</th>
                    <th>Doc Date</th>

                    <th width="100">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@srNo</td>
                        <td>@item.DocNo</td>
                        <td>@item.Remarks</td>
                        <td>@item.CauseListType</td>
                        <td>@item.CaseCountLimit</td>
                        <td>

                        
                            @if (item.IsActive == "F")
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactive
                                </span>
                            }

                        </td>
                        <td>@item.DocDt?.ToString("dd/MM/yyyy")</td>

                        <td>
                            <a href="@Url.Action("Index", "CauseListConfiguration", new { id = item.TrnRcsatClpParamsId })"
                               class="btn btn-default waves-effect waves-light" title="Click to edit record.">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </td>
                    </tr>
                    srNo++;
                }
            </tbody>

        </table>
    </div>
</div>


<!-- ========== SCRIPTS ========== -->
@section Scripts {
    <script>

        $(document).ready(function() {

            $('#tblCauseList').DataTable({
                dom: 'lBfrtip',
                responsive: true,
                autoWidth: false,
                pageLength: 10,
                lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                paging: true,
                searching: true,
                ordering: true,
                info: true,
                buttons: [
                    { extend: 'print', title: 'Cause List Configuration' },
                    { extend: 'excelHtml5', title: 'Cause List Configuration' }
                ]
            });

            $('.dt-buttons').hide();
        });

        $("#btnPrint").click(function() {
            window.print();
        });

        $("#btnExcel").click(function() {
            let table = document.getElementById("tblCauseList");
            let html = table.outerHTML;
            let url = 'data:application/vnd.ms-excel,' + encodeURIComponent(html);
            let a = document.createElement('a');
            a.href = url;
            a.download = 'CauseListConfiguration.xls';
            a.click();
        });

    </script>
}