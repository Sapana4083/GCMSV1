@model GCMS.Models.ViewModels.CauseListConfigurationViewModel
@{
    ViewData["Title"] = "RCSAT Cause List Configuration";
    var index = 1;
}

<!-- ========== PAGE CONTAINER ========== -->
<div class="container-fluid bg-light rounded-4 m-auto shadow py-4 mt-3 px-3">

    <!-- Header -->
    <div class="d-flex justify-content-between mb-3 border-bottom border-3 pb-3">

        <h4>RCSAT Cause List Configuration</h4>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary" id="btnPrint" title="Click to print.">
                <i class="bi bi-printer-fill"></i>
            </button>
            <button type="button" class="btn btn-success" id="btnExcel" title="Click to download excel.">
                <i class="bi bi-file-earmark-excel"></i>
            </button>
        </div>

    </div>

    <!-- ========== FORM ========== -->
    <form asp-action="Save" asp-controller="CauseListConfiguration" method="post" id="causeListForm">

        @Html.AntiForgeryToken()

        <div class="row">

            <!-- CLP NO -->
            <div class="col-md-3 mb-3">
                <label class="form-label">C.L.P No.</label>
                <input type="text" class="form-control" value="Auto" readonly />
            </div>

            <!-- REMARKS -->
            <div class="col-md-3 mb-3">
                <label asp-for="Remarks" class="form-label">Remarks</label>
                <input asp-for="Remarks" class="form-control" placeholder="" />
            </div>

            <!-- CAUSE LIST TYPE -->
            <div class="col-md-3 mb-3">
                <label asp-for="CauseListType" class="form-label">Cause List Type</label>
                <select asp-for="CauseListType" asp-items="Model.CauseListTypes" class="form-select">
                    <option value="">Select</option>
                </select>
            </div>

            <!-- CASE COUNT LIMIT -->
            <div class="col-md-3 mb-3">
                <label asp-for="CaseCountLimit" class="form-label">Case Count Limit</label>
                <input asp-for="CaseCountLimit" type="number" class="form-control" />
            </div>

            <!-- ACTIVE -->
            <div class="col-md-3 mb-3">
                <label class="form-label">Active</label>
                <div class="form-check form-switch">
                    <input asp-for="Active" class="form-check-input" type="checkbox" role="switch" />
                </div>
            </div>

        </div>

        <!-- ========== CASE DETAILS TABLE ========== -->
        <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-3 pb-3">
            <h5 class="mb-0">Case Details</h5>
        </div>

        <div class="table-responsive">
            <table id="tblCauseListRows" class="table table-bordered table-striped">

                <thead>
                    <tr>
                        <td width="45">
                            <input type="checkbox" id="selectAll" />
                        </td>
                        <td width="55">S.no</td>
                        <th>Case Purpose</th>
                        <th width="180">Purpose Priority</th>
                        <th width="185">DB Bench One</th>
                        <th width="185">DB Bench Two</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var row in ViewBag.CauseListRows)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" class="row-check" name="SelectedIds" value="@row" />
                            </td>
                            <td>@index</td>

                            <td>
                                <select class="form-select" name="CasePurposeId">
                                    <option value="">-- Select Case Purpose --</option>

                                    @foreach (var purpose in ViewBag.CasePurposeList)
                                    {
                                        <option value="@purpose.CasePurposeMastId" selected="@(row.CasePurposeId == purpose.CasePurposeMastId)">
                                            @purpose.CasePurposeEng
                                        </option>
                                    }
                                </select>
                            </td>

                            <td>
                                <input type="number" class="form-control" name="PurposePriority" value="@row.PurposePriority" />
                            </td>

                            <td>
                                <input type="number" class="form-control" name="DBBenchOne" value="@row.DBBenchOne" />
                            </td>

                            <td>
                                <input type="number" class="form-control" name="DBBenchTwo" value="@row.DBBenchTwo" />
                            </td>
                        </tr>
                        index++;
                    }

                </tbody>

            </table>
        </div>

        <!-- ========== BUTTONS ========== -->
        <div class="d-flex justify-content-end gap-2 border-top pt-3">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Submit
            </button>
            <button type="button" class="btn btn-success" id="btnNew">
                <i class="bi bi-plus-circle"></i> New
            </button>
        </div>

    </form>
</div>


<!-- ========== SCRIPTS ========== -->
@section Scripts {
    <script>

        $(document).ready(function() {

            // Select / Unselect all
            $("#selectAll").on("change", function() {
                $(".row-check").prop("checked", $(this).prop("checked"));
            });

            // If individual checkbox unchecked
            $(document).on("change", ".row-check", function() {

                if (!$(this).prop("checked")) {
                    $("#selectAll").prop("checked", false);
                }

                if ($(".row-check:checked").length === $(".row-check").length) {
                    $("#selectAll").prop("checked", true);
                }

            });

            // New button
            $("#btnNew").on("click", function() {
                $("#causeListForm")[0].reset();
                $(".row-check").prop("checked", false);
                $("#selectAll").prop("checked", false);
            });

        });

        $("#btnPrint").click(function() {
            window.print();
        });

        $("#btnExcel").click(function() {
            let table = document.getElementById("tblCauseListRows");
            let html = table.outerHTML;
            let url = 'data:application/vnd.ms-excel,' + encodeURIComponent(html);
            let a = document.createElement('a');
            a.href = url;
            a.download = 'CauseListConfiguration.xls';
            a.click();
        });

    </script>
}