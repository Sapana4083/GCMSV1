@model GCMS.Models.RcsatCaseUpdateViewModel

@{
	ViewData["Title"] = "Connected Case Update";
	Layout = "~/Views/Shared/_Layout.cshtml";
	var CaseType = ViewBag.CaseTypeList as List<GCMS.Models.CaseTypeMaster>;
}

<title>Connected Case Update</title>
@* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"> *@

<style>
	* {
		box-sizing: border-box;
	}

	.page-wrapper {
		max-width: 99%;
		margin: 0 auto;
		background: #fff;
		border-radius: 10px;
		box-shadow: 0 8px 24px rgba(0,0,0,0.12);
		overflow: hidden;
		margin-top: 20px;
	}

	.page-header {
		background: linear-gradient(90deg, #5c85c7, #5c85c7);
		color: #fff;
		padding: 14px 20px;
		font-size: 1.1rem;
		font-weight: 600;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

		.page-header .header-icons i {
			background: rgba(255,255,255,0.2);
			padding: 8px;
			border-radius: 6px;
			margin-left: 8px;
			cursor: pointer;
		}

	.form-body {
		padding: 24px;
	}

	.form-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px 24px;
	}

	.form-group label {
		display: block;
		font-weight: 600;
		font-size: 0.85rem;
		color: #222;
		margin-bottom: 6px;
	}

		.form-group label .required {
			color: #e0374a;
		}

	.form-control {
		width: 100%;
		padding: 9px 10px;
		border: 1px solid #cfd8dc;
		border-radius: 6px;
		font-size: 0.9rem;
		background: #fff;
	}

		.form-control[readonly] {
			background: #eef1f3;
			color: #444;
		}

		.form-control:focus {
			outline: none;
			border-color: #4aa8d8;
			box-shadow: 0 0 0 2px rgba(74,168,216,0.2);
		}

	.alert-warning {
		margin-top: 14px;
		background: #fff8e1;
		border: 1px solid #ffe082;
		color: #8a6d00;
		padding: 10px 14px;
		border-radius: 6px;
		font-size: 0.85rem;
		display: none;
	}

	.linked-cases-panel {
		margin: 24px;
		border: 1px solid #dbe4ea;
		border-radius: 8px;
		overflow: hidden;
	}

	.linked-cases-header {
		background: linear-gradient(90deg, #5c85c7, #5c85c7);
		color: #fff;
		padding: 10px 16px;
		font-weight: 600;
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.toolbar {
		display: flex;
		gap: 6px;
		padding: 10px 16px;
		background: #f4f8fb;
		border-bottom: 1px solid #dbe4ea;
	}

	.btn-icon {
		background: #5c85c7;
		color: #fff;
		border: none;
		width: 32px;
		height: 32px;
		border-radius: 5px;
		cursor: pointer;
		font-size: 0.95rem;
	}

		.btn-icon:hover {
			background: #5c85c7;
		}

		.btn-icon:disabled {
			opacity: 0.4;
			cursor: not-allowed;
		}

	table.grid-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.85rem;
	}

		table.grid-table th {
			background: #f4f8fb;
			text-align: left;
			padding: 10px 12px;
			border-bottom: 1px solid #dbe4ea;
			white-space: nowrap;
			font-weight: 600;
		}

			table.grid-table th .required {
				color: #e0374a;
			}

		table.grid-table td {
			padding: 6px 8px;
			border-bottom: 1px solid #eef1f3;
		}

		table.grid-table input {
			width: 100%;
			padding: 6px 8px;
			border: 1px solid #cfd8dc;
			border-radius: 4px;
			font-size: 0.85rem;
		}

			table.grid-table input[readonly] {
				background: #f4f6f7;
			}

	.row-new {
		background: #fff9e6;
	}

	.row-linked {
		background: #f1fbf4;
	}

	.footer-actions {
		display: flex;
		justify-content: flex-end;
		gap: 10px;
		padding: 20px 24px;
	}

	.btn-primary {
		background: #5c85c7;
		color: #fff;
		border: none;
		padding: 10px 22px;
		border-radius: 6px;
		font-weight: 600;
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 8px;
	}

		.btn-primary:hover {
			background: #5c85c7;
		}

		.btn-primary:disabled {
			opacity: 0.5;
			cursor: not-allowed;
		}

	.loading-overlay {
		position: fixed;
		inset: 0;
		background: rgba(255,255,255,0.6);
		display: none;
		align-items: center;
		justify-content: center;
		font-weight: 600;
		color: #2f6f7a;
		z-index: 999;
	}

		.loading-overlay.active {
			display: flex;
		}
</style>

<body>

	<!-- caseTypeOptions must be declared before addRow()/buildCaseTypeOptionsHtml() are ever called -->
	<script>
		const caseTypeOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
						CaseType != null
								? CaseType.Select(ct => new { value = ct.CaseTypeMastId, text = ct.CaseType })
								: Enumerable.Empty<object>()
				));
	</script>

	<div class="loading-overlay" id="loadingOverlay">Loading…</div>

	<div class="page-wrapper">
		<div class="page-header">
			<span>Connected Case Update</span>
			@* <div class="header-icons">
				<i class="fa-solid fa-list"></i>
				<i class="fa-solid fa-magnifying-glass"></i>
				<i class="fa-solid fa-table-cells"></i>
			</div> *@
		</div>

		<div class="form-body">
			<div class="form-grid">
				<div class="form-group">
					<label>Case Type <span class="required">*</span></label>

					<select asp-for="CaseTypeId" class="form-select" id="CaseTypeId">
						<option value="">Select</option>
						@if (CaseType != null)
						{
							foreach (var ct in CaseType)
							{
								<option value="@ct.CaseTypeMastId">
									@ct.CaseType
								</option>
							}
						}
					</select>
					<span asp-validation-for="CaseTypeId" class="text-danger"></span>
				</div>

				<div class="form-group">
					<label>Linked Case (Main Case) <span class="required">*</span></label>
					<input type="text" id="linkedCaseNo" class="form-control" placeholder="Enter / select main case no." />
				</div>

				<div class="form-group">
					<label>Appellant Name</label>
					<input type="text" id="appellantName" class="form-control" readonly />
				</div>

				<div class="form-group">
					<label>Respondent Name</label>
					<input type="text" id="respondentName" class="form-control" readonly />
				</div>

				<div class="form-group">
					<label>Institution Date</label>
					<input type="date" id="institutionDate" class="form-control" readonly />
				</div>

				<div class="form-group">
					<label>Hearing Date</label>
					<input type="date" id="hearingDate" class="form-control" readonly />
				</div>

				<div class="form-group">
					<label>Connected Case No.</label>
					<input type="text" id="connectedCaseNo" class="form-control" readonly />
				</div>

				<div class="form-group">
					<label>District</label>
					<input type="text" id="district" class="form-control" readonly />
				</div>

				<div class="form-group">
					<label>Purpose Name</label>
					<input type="text" id="purposeName" class="form-control" readonly />
				</div>

				<div class="form-group">
					<label>Court Code</label>
					<input type="text" id="courtCode" class="form-control" value="@(Context.Session.GetString("CourtCode") ?? "N/A")" readonly />
				</div>

				<div class="form-group">
					<label>Case Update ID</label>
					<input type="text" id="caseUpdateID" class="form-control" readonly />
				</div>
			</div>

			<div id="notFoundMsg" class="alert-warning">
				No existing case found for this number — you can still add linked cases below; the main case will be created on Submit.
			</div>
		</div>

		<div class="linked-cases-panel">
			<div class="linked-cases-header">
				@* <i class="fa-solid fa-chevron-up"></i> *@ Linked Cases
			</div>
			<div class="toolbar">
				<button type="button" id="btnAddRow" class="btn-icon" title="Add new linked case"><i class="fa-solid fa-plus"></i></button>
				<button type="button" id="btnDeleteRow" class="btn-icon" title="Delete selected rows"><i class="fa-solid fa-trash"></i></button>
				<button type="button" id="btnRefresh" class="btn-icon" title="Reload from case family"><i class="fa-solid fa-rotate"></i></button>
			</div>

			<table class="grid-table" id="linkedCasesTable">
				<thead>
					<tr>
						<th><input type="checkbox" id="chkAll" /></th>
						<th>S.no</th>
						<th>Case Type <span class="required">*</span></th>
						<th>Child Case <span class="required">*</span></th>
						<th>Parent Case <span class="required">*</span></th>
						<th>Hearing Date <span class="required">*</span></th>
						<th>Appellant Name <span class="required">*</span></th>
						<th>Respondent Name</th>
						<th>District</th>
						<th>Purpose</th>
					</tr>
				</thead>
				<tbody id="linkedCasesBody"></tbody>
			</table>
		</div>

		<div class="footer-actions">
			<button type="button" id="btnSubmit" class="btn-primary"><i class="fa-solid fa-floppy-disk"></i> SUBMIT</button>
			<button type="button" id="btnNew" class="btn-primary"><i class="fa-solid fa-circle-plus"></i> NEW</button>
		</div>
	</div>

	<script>
		let rowCounter = 0;
		let currentCaseUpdateId = null;

		const el = id => document.getElementById(id);
		const showLoading = () => el('loadingOverlay').classList.add('active');
		const hideLoading = () => el('loadingOverlay').classList.remove('active');

		// Builds <option> list for a case-type <select> from the server-supplied caseTypeOptions array,
		// marking whichever option matches selectedValue as selected.
		// function buildCaseTypeOptionsHtml(selectedValue) {
		// 	let html = `<option value="" ${!selectedValue ? 'selected' : ''}>Select an option</option>`;
