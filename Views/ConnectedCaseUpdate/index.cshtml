		function buildCaseTypeOptionsHtml(selectedValue) {
			let html = `<option value="" ${!selectedValue ? 'selected' : ''}>Select an option</option>`;
			caseTypeOptions.forEach(ct => {
				const isSelected = String(selectedValue).trim() === String(ct.text).trim();
				html += `<option value="${ct.value}" ${isSelected ? 'selected' : ''}>${ct.text}</option>`;
			});
			return html;
		}


		// Shared helper — used by both the top-level Linked Case field and every row's Child Case field
		async function fetchCaseDetails(linkCase, caseType, courtCode) {
			const res = await fetch(`/ConnectedCaseUpdate/GetCaseDetails?linkCase=${encodeURIComponent(linkCase)}&caseType=${encodeURIComponent(caseType)}&courtCode=${encodeURIComponent(courtCode)}`);

			if (!res.ok) {
				const text = await res.text();
				console.error('Server error:', res.status, text);
				throw new Error(`Request failed with status ${res.status}`);
			}

			const text = await res.text();
			return text ? JSON.parse(text) : { found: false };
		}

		// ---------- TAB 1: autofill on Linked Case (Main Case) selection ----------
		el('linkedCaseNo').addEventListener('blur', async function () {
			const linkCase = this.value.trim();
			const courtCode = el('courtCode').value.trim();

			const caseTypeSelect = el('CaseTypeId');
			const caseType = caseTypeSelect.selectedOptions[0]?.text.trim() ?? '';

			if (!linkCase) return;

			showLoading();
			try {
				const data = await fetchCaseDetails(linkCase, caseType, courtCode);

				el('notFoundMsg').style.display = data.found ? 'none' : 'block';

				if (data.found) {
					el('appellantName').value = data.appellantName || '';
					el('respondentName').value = data.respondentName || '';
					el('institutionDate').value = data.institutionDate || '';
					el('hearingDate').value = data.hearingDate || '';
					el('district').value = data.district || '';
					el('purposeName').value = data.purposeName || '';
					el('courtCode').value = data.courtCode || courtCode || '';
					currentCaseUpdateId = data.caseUpdateId || null;
					el('caseUpdateID').value = data.caseUpdateId || caseUpdateId || '';
				} else {
					['appellantName','respondentName','institutionDate','hearingDate','district','purposeName','connectedCaseNo']
						.forEach(id => el(id).value = '');
					currentCaseUpdateId = null;
				}

				loadLinkedCaseFamily(linkCase, linkCase, courtCode);


			} catch (err) {
				console.error(err);
				alert('Failed to load case details.');
			} finally {
				hideLoading();
			}
		});

		el('btnRefresh').addEventListener('click', () => {
			const linkCase = el('linkedCaseNo').value.trim();
			const courtCode = el('courtCode').value.trim();
			if (linkCase && courtCode) loadLinkedCaseFamily(linkCase, linkCase, courtCode);
		});

		// ---------- TAB 2: load case family grid ----------
		async function loadLinkedCaseFamily(linkCase, parentCaseNo, courtCode) {
			if (!parentCaseNo || !courtCode) return;

			showLoading();
			try {
				const res = await fetch(`/ConnectedCaseUpdate/GetLinkedCaseFamily?linkCase=${encodeURIComponent(linkCase)}&parentCaseNo=${encodeURIComponent(parentCaseNo)}&courtCode=${encodeURIComponent(courtCode)}`);
				const rows = await res.json();

				el('linkedCasesBody').innerHTML = '';
				rowCounter = 0;
				rows.forEach(r => addRow({
					 TRN_RCSAT_CASEREGID: r.TRN_RCSAT_CASEREGID,
					 caseType: r.caseType,
					childCase:r.childCase,
					parent: r.ParentCaseNo,

					hearingDate: r.hearingDate ? r.hearingDate.substring(0, 10) : '',
					appellantName: r.appellantName,
					respondentName: r.respondentName,
					district: r.district,
					purpose: r.purposeName
				}, false));
			} catch (err) {
				console.error(err);
				alert('Failed to load linked cases.');
			} finally {
				hideLoading();
			}
		}

		// ---------- Add row ----------
		// function addRow(existing = null, isNew = true) {
		// 	debugger;
