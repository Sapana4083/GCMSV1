		function addRow(existing = null, isNew = true) {
			debugger;
			rowCounter++;
			const mainCaseNo = el('linkedCaseNo').value.trim();
			const tbody = el('linkedCasesBody');
			const tr = document.createElement('tr');
			tr.className = isNew ? 'row-new' : 'row-linked';
			if (existing?.caseId) tr.dataset.caseId = existing.caseId;

			// Lock Case Type / Child Case for backend-loaded rows; keep editable for new user-added rows
			const lockFields = !isNew;

			tr.innerHTML = `
				<td><input type="checkbox" class="row-check" /></td>
				<td>${rowCounter}</td>
				<td><select class="row-caseType form-control" ${lockFields ? 'disabled' : ''}>
					${buildCaseTypeOptionsHtml(existing?.caseType)}
				</select></td>
				<td><input type="text" class="row-childCase" value="${existing?.childCase ?? ''}" placeholder="Existing or new case no." ${lockFields ? 'readonly' : ''} /></td>
				<td><input type="text" class="row-parentCase" readonly value="${mainCaseNo}" readonly /></td>
				<td><input type="date" class="row-hearingDate" readonly value="${existing?.hearingDate ?? ''}" /></td>
				<td><input type="text" class="row-appellantName" readonly value="${existing?.appellantName ?? ''}" /></td>
				<td><input type="text" class="row-respondentName" readonly value="${existing?.respondentName ?? ''}" /></td>
				<td><input type="text" class="row-district" readonly value="${existing?.district ?? ''}" /></td>
				<td><input type="text" class="row-purpose" readonly value="${existing?.purpose ?? ''}" /></td>
			`;

			tbody.appendChild(tr);
			const childCaseInput = tr.querySelector('.row-childCase');
			childCaseInput.addEventListener('blur', async function () {
				if (lockFields) return; // skip lookup logic for locked/backend-loaded rows
				const childCaseNo = this.value.trim();
				const caseTypeSelect = tr.querySelector('.row-caseType');
				const caseType = caseTypeSelect.selectedOptions[0]?.text.trim() ?? '';
				const courtCode = el('courtCode').value.trim();
				if (!childCaseNo || !caseTypeSelect.value) return;
				try {
					const data = await fetchCaseDetails(childCaseNo, caseType, courtCode);
					if (data.found) {
						tr.className = 'row-linked';
						tr.dataset.caseId = (data.caseUpdateId && data.caseUpdateId !== 'NA') ? data.caseUpdateId : '';
						tr.querySelector('.row-hearingDate').value = data.hearingDate ? data.hearingDate.substring(0, 10) : '';
						tr.querySelector('.row-appellantName').value = data.appellantName || '';
						tr.querySelector('.row-respondentName').value = data.respondentName || '';
						tr.querySelector('.row-district').value = data.district || '';
						tr.querySelector('.row-purpose').value = data.purposeName || '';
					} else {
						tr.className = 'row-new';
						delete tr.dataset.caseId;
						['row-hearingDate','row-appellantName','row-respondentName','row-district','row-purpose']
							.forEach(cls => {
								const field = tr.querySelector(`.${cls}`);
								if (field) field.value = '';
							});
					}
				} catch (err) {
					console.error(err);
					alert('Failed to load case details for this row.');
				}
			});
		}

		el('btnAddRow').addEventListener('click', () => {
			if (!el('linkedCaseNo').value.trim()) {
				alert('Please enter the Linked Case (Main Case) number first.');
				return;
			}
			if (!el('appellantName').value.trim() || !el('institutionDate').value.trim()) {
			alert('No existing case found for this number !!');
			return;
			}


		if (!validateLastRow()) return; // block adding a new row until the current last row is complete
		addRow(null, true);
			
			
		});

		function validateLastRow() {
			const rows = document.querySelectorAll('#linkedCasesBody tr');
			if (rows.length === 0) return true; // no rows yet, nothing to validate

			const lastRow = rows[rows.length - 1];

			const caseType = lastRow.querySelector('.row-caseType').value;
			const childCase = lastRow.querySelector('.row-childCase').value.trim();
			const hearingDate = lastRow.querySelector('.row-hearingDate').value.trim();
			const appellantName = lastRow.querySelector('.row-appellantName').value.trim();

			if (!caseType) {
				alert('Please select Case Type for the current row before adding a new one.');
				lastRow.querySelector('.row-caseType').focus();
				return false;
			}
			if (!childCase) {
				alert('Please enter Child Case number for the current row before adding a new one.');
				lastRow.querySelector('.row-childCase').focus();
				return false;
			}
			if (!hearingDate) {
				alert('Please enter Hearing Date for the current row before adding a new one.');
				lastRow.querySelector('.row-hearingDate').focus();
				return false;
			}
			if (!appellantName) {
				alert('Please enter Appellant Name for the current row before adding a new one.');
				lastRow.querySelector('.row-appellantName').focus();
				return false;
			}

			return true;
		}

		el('btnDeleteRow').addEventListener('click', async () => {
			const checked = [...document.querySelectorAll('.row-check:checked')];
			if (checked.length === 0) {
				alert('Select at least one row to delete.');
				return;
			}
			if (!confirm(`Delete ${checked.length} selected row(s)?`)) return;

			for (const chk of checked) {
				const tr = chk.closest('tr');
				const caseId = tr.dataset.caseId;
				if (caseId) {
					await fetch(`/ConnectedCaseUpdate/DeleteLinkedCase?caseId=${caseId}`, { method: 'POST' });
				}
				tr.remove();
			}
		});

		el('chkAll').addEventListener('change', function () {
			document.querySelectorAll('.row-check').forEach(cb => cb.checked = this.checked);
		});

		// ---------- SUBMIT ----------
		el('btnSubmit').addEventListener('click', async () => {
			const mainCaseNo = el('linkedCaseNo').value.trim();
			if (!mainCaseNo) {
				alert('Please enter the Linked Case (Main Case) number first.');
				return;
			}
			if (!el('CaseTypeId').value) {
				alert('Please select a Case Type.');
				return;
			}

			const linkedCases = [...document.querySelectorAll('#linkedCasesBody tr')].map(tr => ({
				caseId: tr.dataset.caseId ? parseInt(tr.dataset.caseId) : null,
				caseTypee: tr.querySelector('.row-caseType').value,
				caseNo: tr.querySelector('.row-childCase').value,
				mainCase: mainCaseNo,
				hearingDate: tr.querySelector('.row-hearingDate').value || null,
				appellantName: tr.querySelector('.row-appellantName').value,
				respondentName: tr.querySelector('.row-respondentName').value,
				districtName: tr.querySelector('.row-district').value,
				purpose: tr.querySelector('.row-purpose').value
			})).filter(r => r.caseNo);

			const model = {
				caseUpdateId: currentCaseUpdateId,
				courtName: el('courtCode').value,
				courtCode: el('courtCode').value,
				caseType: el('CaseTypeId').value,
				linkCase: mainCaseNo,
				appellantName: el('appellantName').value,
				respondentName: el('respondentName').value,
				institutionDate: el('institutionDate').value || null,
				hearingDate: el('hearingDate').value || null,
				connectedCaseNo: el('connectedCaseNo').value,
				district: el('district').value,
				purposeName: el('purposeName').value,
				linkedCases: linkedCases
			};

			el('btnSubmit').disabled = true;
			showLoading();
			try {
				const res = await fetch('/RcsatCaseUpdate/Save', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(model)
				});
				const result = await res.json();

				if (result.success) {
					currentCaseUpdateId = result.caseUpdateId;
					alert('Saved successfully.');
				} else {
					alert('Save failed: ' + (result.message || 'Unknown error'));
				}
			} catch (err) {
				console.error(err);
				alert('Save failed due to a network/server error.');
			} finally {
				el('btnSubmit').disabled = false;
				hideLoading();
			}
		});

		// ---------- NEW ----------
		el('btnNew').addEventListener('click', () => {
			document.querySelectorAll('.form-control').forEach(elm => elm.value = '');
			el('linkedCasesBody').innerHTML = '';
			el('notFoundMsg').style.display = 'none';
			rowCounter = 0;
			currentCaseUpdateId = null;
		});
	</script>

</body>
</html>
