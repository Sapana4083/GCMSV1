@model GCMS.Models.ViewModels.ConnectedCaseUpdateViewModel

@{
    ViewData["Title"] = "Connected Case Update";
    var caseTypes = ViewBag.CaseTypeList as List<GCMS.Models.CaseTypeMaster>;
}

<div class="container-fluid bg-light rounded-4 m-auto shadow py-4 px-3 mt-3">

    @Html.AntiForgeryToken()

    <div class="d-flex justify-content-between mb-3 border-bottom border-3 pb-3">
        <h4>Connected Case Update</h4>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Case Type<span class="text-danger">*</span></label>
            <select id="CaseTypeId" class="form-select">
                <option value="">Select</option>
                @if (caseTypes != null)
                {
                    foreach (var ct in caseTypes)
                    {
                        <option value="@ct.CaseTypeMastId">@(!string.IsNullOrWhiteSpace(ct.CaseType) ? ct.CaseType : ct.CaseTypeEng)</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Linked Case (Main Case)<span class="text-danger">*</span></label>
            <input type="text" id="linkedCaseNo" class="form-control" placeholder="Enter main case no." />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Case Update ID</label>
            <input type="text" id="caseUpdateID" class="form-control" readonly />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Appellant Name</label>
            <input type="text" id="appellantName" class="form-control" readonly />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Respondent Name</label>
            <input type="text" id="respondentName" class="form-control" readonly />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">District</label>
            <input type="text" id="district" class="form-control" readonly />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Institution Date</label>
            <input type="date" id="institutionDate" class="form-control" readonly />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Hearing Date</label>
            <input type="date" id="hearingDate" class="form-control" readonly />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Purpose Name</label>
            <input type="text" id="purposeName" class="form-control" readonly />
        </div>

        <div class="col-md-4 mb-3">
            <label class="form-label">Court Code</label>
            <input type="text" id="courtCode" class="form-control" value="@(Context.Session.GetString("CourtCode") ?? "")" readonly />
        </div>
    </div>

    <div class="alert alert-warning" id="notFoundMsg" style="display:none;">
        No existing record was found for this main case. Appellant details are required to save.
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3 mb-3 border-bottom border-3 pb-3">
        <h5 class="mb-0">Linked Cases</h5>

        <div class="d-flex gap-2">
            <button type="button" id="btnAddRow" class="btn btn-default waves-effect waves-light" title="Add row">
                <i class="bi bi-plus-lg"></i>
            </button>
            <button type="button" id="btnDeleteRow" class="btn btn-default waves-effect waves-light" title="Remove selected (unsaved) rows">
                <i class="bi bi-trash3"></i>
            </button>
            <button type="button" id="btnRefresh" class="btn btn-default waves-effect waves-light" title="Reload">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped" id="linkedCasesTable">
            <thead>
                <tr>
                    <td width="40"><input type="checkbox" id="chkAll" /></td>
                    <td width="55">S.no</td>
                    <th>Case Type<span class="text-danger">*</span></th>
                    <th>Child Case<span class="text-danger">*</span></th>
                    <th>Parent Case</th>
                    <th>Hearing Date</th>
                    <th>Appellant Name</th>
                    <th>Respondent Name</th>
                    <th>District</th>
                    <th>Purpose</th>
                </tr>
            </thead>
            <tbody id="linkedCasesBody"></tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end gap-2 border-top pt-3">
        <button type="button" id="btnSubmit" class="btn btn-primary"><i class="bi bi-save"></i> Submit</button>
        <button type="button" id="btnNew" class="btn btn-success"><i class="bi bi-plus-circle"></i> New</button>
    </div>
</div>

@section Scripts {
    <script>
        const caseTypeOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    (caseTypes ?? new List<GCMS.Models.CaseTypeMaster>())
                            .Select(ct => new { value = ct.CaseTypeMastId, text = !string.IsNullOrWhiteSpace(ct.CaseType) ? ct.CaseType : ct.CaseTypeEng })));

        const el = id => document.getElementById(id);
        let currentCaseUpdateId = null;
        let fetchTimer = null;
        let lastKey = '';

        function typeOptions(selected) {
            let h = '<option value="">Select an option</option>';
            caseTypeOptions.forEach(c => {
                h += `<option value="${c.value}" ${String(selected) === String(c.value) ? 'selected' : ''}>${c.text}</option>`;
            });
            return h;
        }

        function renumber() {
            document.querySelectorAll('#linkedCasesBody tr').forEach((tr, i) => tr.querySelector('.row-sno').textContent = i + 1);
        }

        const val = x => (x ?? '').toString().replace(/"/g, '&quot;');

        // Parent case information (used to prefill new rows)
        function parentInfo() {
            return {
                caseTypeId: el('CaseTypeId').value,
                hearingDate: el('hearingDate').value,
                appellantName: el('appellantName').value,
                respondentName: el('respondentName').value,
                district: el('district').value,
                purpose: el('purposeName').value
            };
        }

        function addRow(r, locked) {
            const tr = document.createElement('tr');
            if (r && r.linkedCaseId) tr.dataset.linkedId = r.linkedCaseId;

            tr.innerHTML = `
                <td><input type="checkbox" class="row-check" /></td>
                <td class="row-sno"></td>
                <td><select class="row-caseType form-select" ${locked ? 'disabled' : ''}>${typeOptions(r?.caseTypeId)}</select></td>
                <td><input type="text" class="row-childCase form-control" value="${val(r?.caseNo)}" ${locked ? 'readonly' : ''} /></td>
                <td><input type="text" class="form-control" value="${val(el('linkedCaseNo').value.trim())}" readonly /></td>
                <td><input type="date" class="row-hearingDate form-control" value="${val(r?.hearingDate)}" readonly /></td>
                <td><input type="text" class="row-appellant form-control" value="${val(r?.appellantName)}" readonly /></td>
                <td><input type="text" class="row-respondent form-control" value="${val(r?.respondentName)}" readonly /></td>
                <td><input type="text" class="row-district form-control" value="${val(r?.district)}" readonly /></td>
                <td><input type="text" class="row-purpose form-control" value="${val(r?.purpose)}" readonly /></td>`;
            el('linkedCasesBody').appendChild(tr);
            renumber();

            tr.querySelector('.row-childCase').addEventListener('blur', async function () {
                if (locked || !this.value.trim()) return;

                const typeId = tr.querySelector('.row-caseType').value;
                const res = await fetch(`/ConnectedCaseUpdate/GetChildCase?caseNo=${encodeURIComponent(this.value.trim())}&caseTypeId=${typeId}`);
                const d = await res.json();
                const p = parentInfo();

                // Child ki info mili to wo, warna parent case ki info
                if (d.found) {
                    tr.querySelector('.row-caseType').value = d.caseTypeId || p.caseTypeId;
                    tr.querySelector('.row-hearingDate').value = d.hearingDate || p.hearingDate;
                    tr.querySelector('.row-appellant').value = d.appellantName || p.appellantName;
                    tr.querySelector('.row-respondent').value = d.respondentName || p.respondentName;
                    tr.querySelector('.row-district').value = d.district || p.district;
                    tr.querySelector('.row-purpose').value = d.purpose || p.purpose;
                } else {
                    tr.querySelector('.row-caseType').value = p.caseTypeId;
                    tr.querySelector('.row-hearingDate').value = p.hearingDate;
                    tr.querySelector('.row-appellant').value = p.appellantName;
                    tr.querySelector('.row-respondent').value = p.respondentName;
                    tr.querySelector('.row-district').value = p.district;
                    tr.querySelector('.row-purpose').value = p.purpose;
                }
            });
        }

        function clearHeader() {
            ['appellantName', 'respondentName', 'district', 'institutionDate', 'hearingDate', 'purposeName', 'caseUpdateID']
                .forEach(id => el(id).value = '');
            currentCaseUpdateId = null;
        }

        async function loadMainCase(force) {
            const caseNo = el('linkedCaseNo').value.trim();
            const typeId = el('CaseTypeId').value;

            // Fetch only when both fields are filled.
            if (!caseNo || !typeId) return;

            const key = caseNo + '|' + typeId;
            if (force !== true && key === lastKey) return;
            lastKey = key;

            try {
                const res = await fetch(`/ConnectedCaseUpdate/GetByMainCase?caseNo=${encodeURIComponent(caseNo)}&caseTypeId=${encodeURIComponent(typeId)}`);
                if (!res.ok) throw new Error('Request failed: ' + res.status);
                const d = await res.json();

                el('notFoundMsg').style.display = d.found ? 'none' : 'block';
                el('linkedCasesBody').innerHTML = '';

                if (!d.found) {
                    clearHeader();
                    return;
                }

                if (d.caseTypeId) el('CaseTypeId').value = d.caseTypeId;
                el('appellantName').value = d.appellantName || '';
                el('respondentName').value = d.respondentName || '';
                el('district').value = d.district || '';
                el('institutionDate').value = d.institutionDate || '';
                el('hearingDate').value = d.hearingDate || '';
                el('purposeName').value = d.purposeName || '';
                el('courtCode').value = d.courtCode || el('courtCode').value;
                el('caseUpdateID').value = d.caseUpdateId || '';
                currentCaseUpdateId = d.caseUpdateId || null;

                (d.rows || []).forEach(r => addRow(r, true));
            } catch (e) {
                console.error(e);
                alert('Failed to load case details.');
            }
        }

        function scheduleFetch() {
            clearTimeout(fetchTimer);
            fetchTimer = setTimeout(() => loadMainCase(), 600);
        }

        el('linkedCaseNo').addEventListener('input', scheduleFetch);
        el('linkedCaseNo').addEventListener('blur', () => loadMainCase());
        el('CaseTypeId').addEventListener('change', () => loadMainCase());
        el('btnRefresh').addEventListener('click', () => loadMainCase(true));

        el('btnAddRow').addEventListener('click', () => {
            if (!el('linkedCaseNo').value.trim()) { alert('Please enter the Linked Case (Main Case) first.'); return; }

            const rows = document.querySelectorAll('#linkedCasesBody tr');
            if (rows.length) {
                const last = rows[rows.length - 1];
                if (!last.querySelector('.row-childCase').value.trim()) {
                    alert('Please enter the Child Case for the current row first.');
                    return;
                }
            }

            // New row: Case Type + parent case information auto-filled
            const p = parentInfo();
            addRow({
                caseTypeId: p.caseTypeId,
                hearingDate: p.hearingDate,
                appellantName: p.appellantName,
                respondentName: p.respondentName,
                district: p.district,
                purpose: p.purpose
            }, false);
        });

        el('btnDeleteRow').addEventListener('click', () => {
            let blocked = false;
            document.querySelectorAll('.row-check:checked').forEach(c => {
                const tr = c.closest('tr');
                if (tr.dataset.linkedId) { blocked = true; return; }
                tr.remove();
            });
            if (blocked) alert('Saved rows cannot be deleted (no delete action is available).');
            renumber();
        });

        el('chkAll').addEventListener('change', function () {
            document.querySelectorAll('.row-check').forEach(c => c.checked = this.checked);
        });

        el('btnSubmit').addEventListener('click', async () => {
            const mainCase = el('linkedCaseNo').value.trim();
            if (!mainCase) { alert('Linked Case (Main Case) is required.'); return; }
            if (!el('CaseTypeId').value) { alert('Please select a Case Type.'); return; }
            if (!el('appellantName').value.trim()) { alert('Appellant details are required to save.'); return; }

            const ctSel = el('CaseTypeId');
            const rows = [...document.querySelectorAll('#linkedCasesBody tr')].map(tr => {
                const sel = tr.querySelector('.row-caseType');
                return {
                    linkedCaseId: tr.dataset.linkedId ? parseInt(tr.dataset.linkedId) : null,
                    caseTypeId: sel.value ? parseInt(sel.value) : null,
                    caseTypeName: sel.selectedOptions[0]?.text ?? '',
                    caseNo: tr.querySelector('.row-childCase').value.trim(),
                    hearingDate: tr.querySelector('.row-hearingDate').value || null,
                    appellantName: tr.querySelector('.row-appellant').value,
                    respondentName: tr.querySelector('.row-respondent').value,
                    district: tr.querySelector('.row-district').value,
                    purpose: tr.querySelector('.row-purpose').value
                };
            });

            const payload = {
                caseUpdateId: currentCaseUpdateId,
                courtCode: el('courtCode').value,
                caseTypeId: parseInt(ctSel.value),
                caseTypeName: ctSel.selectedOptions[0].text,
                linkCase: mainCase,
                appellantName: el('appellantName').value,
                respondentName: el('respondentName').value,
                institutionDate: el('institutionDate').value || null,
                hearingDate: el('hearingDate').value || null,
                district: el('district').value,
                purposeName: el('purposeName').value,
                rows: rows
            };

            el('btnSubmit').disabled = true;
            try {
                const res = await fetch('/ConnectedCaseUpdate/Save', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(payload)
                });
                const r = await res.json();
                alert(r.message || (r.success ? 'Saved successfully.' : 'Save failed.'));
                if (r.success) { currentCaseUpdateId = r.caseUpdateId; loadMainCase(); }
            } catch (e) {
                console.error(e);
                alert('Save failed due to a network or server error.');
            } finally {
                el('btnSubmit').disabled = false;
            }
        });

        el('btnNew').addEventListener('click', () => {
            el('linkedCaseNo').value = '';
            el('CaseTypeId').value = '';
            el('linkedCasesBody').innerHTML = '';
            el('notFoundMsg').style.display = 'none';
            clearHeader();
        });
    </script>
}