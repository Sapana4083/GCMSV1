@model List<GCMS.Models.BenchTypeMaster>

@{
    ViewData["Title"] = "Bench Type Master";
    var srNo = 1;
    var courtList = ViewBag.CourtList as SelectList;
}

<!-- ========== PAGE CONTAINER ========== -->
<div class="container-fluid bg-light rounded-4 m-auto shadow mt-3 py-4 px-3">

    <!-- Header -->
    <div class="d-flex justify-content-between mb-3 border-bottom border-3 pb-3">

        <h4>Bench Type Master</h4>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary" id="btnAddBenchType" title="Click to add new record.">
                Add Bench Type
            </button>
            <button type="button" class="btn btn-secondary" id="btnPrint" title="Click to print.">
                <i class="bi bi-printer-fill"></i>
            </button>
            <button type="button" class="btn btn-success" id="btnExcel" title="Click to download excel.">
                <i class="bi bi-file-earmark-excel"></i>
            </button>
        </div>

    </div>
    <div class="table-responsive">
        <!-- Data Table -->
        <table id="tblBenchType" class="table table-bordered table-striped">

        <thead>
            <tr>
                <td width="50">S. No.</td>
                <th>Bench Type Code</th>
                <th>Bench Type</th>
                <th>Active</th>
                <th>Created By</th>
                <th>Modified Date</th>

                    <th width="180">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@srNo</td>
                        <td>@item.BenchTypeCode</td>
                        <td>@item.BenchType</td>
                        <td>

                        
                            @if (item.IsActive == "1")
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactive
                                </span>
                            }

                        </td>
                        <td>@item.CreatedBy</td>
                        <td>@item.ModifiedOn</td>

                    <td>
                        <button type="button"
                                class="btn btn-default waves-effect waves-light edit"
                                    data-id="@item.BenchTypeMastId" title="Click to edit record.">
                                <i class="bi bi-pencil-square"></i>
                        </button>
                        </td>
                    </tr>
                    srNo++;
                }
            </tbody>

        </table>
    </div>
</div>


<!-- ========== MODAL ========== -->
<div class="modal fade" id="benchTypeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title">Bench Type Master</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post">

                @Html.AntiForgeryToken()

                <!-- Modal Body -->
                <div class="modal-body">

                    <input type="hidden" id="BenchTypeMastId" />

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Court Name</label>
                            @if (courtList != null)
                            {
                                @Html.DropDownList(
                                    "CourtTypeName",
                                    courtList,
                                    "Select an option",
                                    new { @class = "form-select", id = "CourtName" }
                                )
                            }
                            else
                            {
                                <select class="form-select" id="CourtName">
                                    <option value="">Select an option</option>
                                </select>
                            }
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label">Bench Type Code</label>
                            <input type="text" id="BenchTypeCode" class="form-control" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label">Bench Type<span class="text-danger">*</span></label>
                            <input type="text" id="BenchType" class="form-control" />
                            <span class="text-danger" id="errBenchType"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label">Is Active</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="IsActive">
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Modal Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Close
                    </button>
                    <button type="button" class="btn btn-success" id="btnSave">
                        Save
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>


<!-- ========== SCRIPTS ========== -->
@section Scripts {
    <script>

        // ── Init ─────────────────────────────────────────────
        $(document).ready(function() {

            $('#tblBenchType').DataTable({

                dom: 'lBfrtip',

                responsive: true,
                autoWidth: false,

                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],

                paging: true,
                searching: true,
                ordering: true,
                info: true,

                columnDefs: [{
                    responsivePriority: 1,
                    targets: 6
                },
                {
                    responsivePriority: 2,
                    targets: 0
                }
                ],

                buttons: [{
                    extend: 'print',
                    title: 'Bench Type Master'
                },
                {
                    extend: 'excelHtml5',
                    title: 'Bench Type Master'
                }
                ]
            });

            $('.dt-buttons').hide();
        });
        $("#btnPrint").click(function() {

            window.print();

        });

        $("#btnExcel").click(function() {

            let table = document.getElementById("tblBenchType");

            let html = table.outerHTML;

            let url = 'data:application/vnd.ms-excel,' +
                encodeURIComponent(html);

            let a = document.createElement('a');

            a.href = url;
            a.download = 'BenchTypeMaster.xls';

            a.click();

        });

        var benchTypeModal = new bootstrap.Modal(
            document.getElementById('benchTypeModal')
        );

        // ── Add Bench Type ─────────────────────────────────────
        $("#btnAddBenchType").click(function() {
            $("#BenchTypeMastId").val('');
            $("#CourtName").val('');
            $("#BenchTypeCode").val('');
            $("#BenchType").val('');
            $("#errBenchType").text('');
            $("#IsActive").prop("checked", false);
            benchTypeModal.show();
        });

        

        // ── Edit Bench Type ────────────────────────────────────
        $(document).on("click", ".edit", function() {
            var id = $(this).data("id");
            
            $.ajax({
                url: '/CourtMaster/GetBenchType',
                type: 'GET',
                data: {
                    id: id
                },
                success: function(data) {

                    console.log(data);

                    if (!data) {
                        alert("No data returned from server");
                        return;
                    }

                    $("#BenchTypeMastId").val(data.benchTypeMastId);
                    $("#CourtName").val(data.courtName);
                    $("#BenchTypeCode").val(data.benchTypeCode);
                    $("#BenchType").val(data.benchType);
                    $("#IsActive").prop(
                        "checked",
                        data.isActive === "Y"
                    );
                    $("#errBenchType").text('');
                    benchTypeModal.show();
                }
            });
        });

        // ── Save Bench Type ────────────────────────────────────
        $("#btnSave").click(function() {
            
            var token = $('input[name="__RequestVerificationToken"]').val();
            let isValid = true;

            $("#errBenchType").text('');

            if ($("#BenchType").val().trim() === "") {
                $("#errBenchType").text("Bench Type is required");
                isValid = false;
            }

            if (!isValid)
                return;

            
            $.ajax({
                url: '/CourtMaster/SaveBenchType',
                type: 'POST',
                headers: {
                    RequestVerificationToken: token
                },
                data: {
                    BenchTypeMastId: $("#BenchTypeMastId").val() || 0,
                    CourtName: $("#CourtName").val(),
                    BenchTypeCode: $("#BenchTypeCode").val(),
                    BenchType: $("#BenchType").val(),
                    IsActive: $("#IsActive").is(":checked") ? 1 : 0
                },
              
                success: function(r) {
                    if (r.success) {
                        benchTypeModal.hide();
                        location.reload();
                    } else {
                        alert(r.message);
                    }
                },
                error: function() {
                    alert("Save Failed");
                }
            });
        });

    </script>
}