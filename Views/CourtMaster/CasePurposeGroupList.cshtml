@model List<GCMS.Models.CasePurposeGroupMaster>

@{
    ViewData["Title"] = "Case Purpose Group Master";
    var srNo = 1;
}
<div class="container-fluid bg-light rounded-4 m-auto shadow py-4 px-3">
    <!-- Header -->
    <div class="d-flex justify-content-between mb-3 border-bottom border-3 pb-3">

        <h4>Case Purpose Group Master</h4>

        <div class="d-flex gap-2">
            <button type="button"
                    class="btn btn-primary"
                    id="btnAddCasePurposeGroup"
                    title="Click to add new record.">

                Add Case Purpose Group

            </button>

            <button type="button"
                    class="btn btn-secondary"
                    id="btnPrint"
                    title="Click to print.">

                <i class="bi bi-printer-fill"></i>

            </button>

            <button type="button"
                    class="btn btn-success"
                    id="btnExcel"
                    title="Click to download excel.">

                <i class="bi bi-file-earmark-excel"></i>

            </button>
        </div>

    </div>

    <div class="table-responsive">

        <!-- Data Table -->

        <table id="tblCasePurposeGroup"
               class="table table-bordered table-striped">

            <thead>

                <tr>

                    <th width="50">S. No.</th>

                    <th>Case Code</th>

                    <th>Case Purpose Group</th>

                    <th>English Name</th>

                    <th>Order Level</th>

                    <th>RB ID</th>

                    @* <th>RB CL Priority</th> *@

                    <th>Active</th>

                    <th>Created By</th>

                    <th>Modified Date</th>

                    <th width="180">Action</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@srNo</td>

                        <td>@item.CaseCode</td>

                        <td>@item.CasePurposeGroup</td>

                        <td>@item.CasePurposeGroupEng</td>

                        <td>@item.OrderLevel</td>

                        <td>@item.RbId</td>

                        @* <td>@item.RbClPriority</td> *@

                        <td>

                            @if (item.Cancel == "T")
                            {
                                <span class="badge bg-danger">
                                    Inactive
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }

                        </td>

                        <td>@item.CreatedBy</td>

                        <td>@item.ModifiedOn</td>

                        <td>

                            <button type="button"
                                    class="btn btn-default waves-effect waves-light edit"
                                    data-id="@item.CasePurposeGroupMastId"
                                    title="Click to edit record.">

                                <i class="bi bi-pencil-square"></i>

                            </button>

                        </td>

                    </tr>

                    srNo++;
                }

            </tbody>

        </table>

    </div>
</div>
<!-- Bootstrap Modal -->

<div class="modal fade"
     id="casePurposeGroupModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-xl">

        <div class="modal-content">

            <div class="modal-header bg-primary text-white">

                <h5 class="modal-title" id="casePurposeGroupModalTitle">
                    Add Case Purpose Group
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <form id="frmCasePurposeGroup">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="CasePurposeGroupMastId"
                           name="CasePurposeGroupMastId" />

                    <div class="row">

                        <div class="col-md-4 mb-3">

                            <label class="form-label">
                                Case Code
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   id="CaseCode"
                                   name="CaseCode"
                                   maxlength="10"
                                   class="form-control" />

                            <span class="text-danger"
                                  id="errCaseCode"></span>

                        </div>

                        <div class="col-md-4 mb-3">

                            <label class="form-label">
                                Case Purpose Group
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   id="CasePurposeGroup"
                                   name="CasePurposeGroup"
                                   maxlength="100"
                                   class="form-control" />

                            <span class="text-danger"
                                  id="errCasePurposeGroup"></span>

                        </div>

                        <div class="col-md-4 mb-3">

                            <label class="form-label">
                                English Name
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   id="CasePurposeGroupEng"
                                   name="CasePurposeGroupEng"
                                   maxlength="100"
                                   class="form-control" />

                            <span class="text-danger"
                                  id="errCasePurposeGroupEng"></span>

                        </div>

                        <div class="col-md-4 mb-3">

                            <label class="form-label">
                                Order Level
                            </label>

                            <input type="number"
                                   id="OrderLevel"
                                   name="OrderLevel"
                                   class="form-control" />

                            <span class="text-danger"
                                  id="errOrderLevel"></span>

                        </div>

                        <div class="col-md-4 mb-3">

                            <label class="form-label">
                                RB ID
                            </label>

                            <input type="text"
                                   id="RbId"
                                   name="RbId"
                                   maxlength="10"
                                   class="form-control" />

                            <span class="text-danger"
                                  id="errRbId"></span>

                        </div>

                        @* <div class="col-md-4 mb-3">

                            <label class="form-label">
                                RB CL Priority
                            </label>

                            <input type="number"
                                   id="RbClPriority"
                                   name="RbClPriority"
                                   class="form-control" />

                            <span class="text-danger"
                                  id="errRbClPriority"></span>

                        </div> *@
                        <div class="col-md-4 mb-3">

                            <label class="form-label">
                                Active
                            </label>

                            <div class="form-check form-switch">

                                <input class="form-check-input"
                                       type="checkbox"
                                       id="Cancel"
                                       name="Cancel" />

                                <label class="form-check-label"
                                       for="Cancel"
                                       id="lblCancel">
                                    No
                                </label>

                            </div>

                        </div>

                    </div>

                </form>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

                <button type="button"
                        class="btn btn-success"
                        id="btnSave">

                    <i class="bi bi-check-circle"></i>

                    Save

                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>

        // ── Init ─────────────────────────────────────────────
        $(document).ready(function() {

            $('#tblCasePurposeGroup').DataTable({

                dom: 'lBfrtip',

                responsive: true,
                autoWidth: false,

                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],

                paging: true,
                searching: true,
                ordering: true,
                info: true,

                columnDefs: [{
                    responsivePriority: 1,
                    targets: 9
                },
                {
                    responsivePriority: 2,
                    targets: 0
                }
                ],

                buttons: [{
                    extend: 'print',
                    title: 'Case Purpose Group Master'
                },
                {
                    extend: 'excelHtml5',
                    title: 'Case Purpose Group Master'
                }
                ]
            });

            $('.dt-buttons').hide();
        });

        $("#btnPrint").click(function() {

            window.print();

        });

        $("#btnExcel").click(function() {

            let table = document.getElementById("tblCasePurposeGroup");

            let html = table.outerHTML;

            let url = 'data:application/vnd.ms-excel,' +
                encodeURIComponent(html);

            let a = document.createElement('a');

            a.href = url;
            a.download = 'CasePurposeGroupMaster.xls';

            a.click();

        });

        var casePurposeGroupModal = new bootstrap.Modal(
            document.getElementById('casePurposeGroupModal')
        );

        // ── Add Case Purpose Group ─────────────────────────────
        $("#btnAddCasePurposeGroup").click(function() {
            $("#CasePurposeGroupMastId").val('');
            $("#CaseCode").val('');
            $("#CasePurposeGroup").val('');
            $("#CasePurposeGroupEng").val('');
            $("#OrderLevel").val('');
            $("#RbId").val('');
            $("#RbClPriority").val('');
            $("#errCaseCode").text('');
            $("#errCasePurposeGroup").text('');
            $("#errCasePurposeGroupEng").text('');
            $("#errOrderLevel").text('');
            $("#errRbId").text('');
            $("#errRbClPriority").text('');
            $("#Cancel").prop("checked", false);
            $("#lblCancel").text("No");
            casePurposeGroupModal.show();
        });



        // ── Edit Case Purpose Group ────────────────────────────
        $(document).on("click", ".edit", function() {
            var id = $(this).data("id");

            $.ajax({
                url: '/CourtMaster/GetCasePurposeGroup',
                type: 'GET',
                data: {
                    id: id
                },
                success: function(data) {

                    console.log(data);

                    if (!data) {
                        alert("No data returned from server");
                        return;
                    }

                    $("#CasePurposeGroupMastId").val(data.casePurposeGroupMastId);
                    $("#CaseCode").val(data.caseCode);
                    $("#CasePurposeGroup").val(data.casePurposeGroup);
                    $("#CasePurposeGroupEng").val(data.casePurposeGroupEng);
                    $("#OrderLevel").val(data.orderLevel);
                    $("#RbId").val(data.rbId);
                    $("#RbClPriority").val(data.rbClPriority);
                    $("#Cancel").prop(
                        "checked",
                        data.cancel === "T"
                    );
                    $("#lblCancel").text(
                        data.cancel === "T" ? "Yes" : "No"
                    );
                    $("#errCaseCode").text('');
                    $("#errCasePurposeGroup").text('');
                    $("#errCasePurposeGroupEng").text('');
                    $("#errOrderLevel").text('');
                    $("#errRbId").text('');
                    $("#errRbClPriority").text('');
                    casePurposeGroupModal.show();
                }
            });
        });

        // ── Save Case Purpose Group ─────────────────────────────
        $("#btnSave").click(function() {
            debugger

            var token = $('input[name="__RequestVerificationToken"]').val();
            console.log(token);
            let isValid = true;

            $("#errCaseCode").text('');
            $("#errCasePurposeGroup").text('');
            $("#errCasePurposeGroupEng").text('');
            $("#errOrderLevel").text('');
            $("#errRbId").text('');
            $("#errRbClPriority").text('');

            if ($("#CaseCode").val().trim() === "") {
                $("#errCaseCode").text("Case Code is required");
                isValid = false;
            }

            if ($("#CasePurposeGroup").val().trim() === "") {
                $("#errCasePurposeGroup").text("Case Purpose Group is required");
                isValid = false;
            }

            if ($("#CasePurposeGroupEng").val().trim() === "") {
                $("#errCasePurposeGroupEng").text("English Name is required");
                isValid = false;
            }

            if (!isValid)
                return;


            $.ajax({
                url: '/CourtMaster/SaveCasePurposeGroup',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': token
                },
                data: {
                    CasePurposeGroupMastId: $("#CasePurposeGroupMastId").val(),
                    CaseCode: $("#CaseCode").val(),
                    CasePurposeGroup: $("#CasePurposeGroup").val(),
                    CasePurposeGroupEng: $("#CasePurposeGroupEng").val(),
                    OrderLevel: $("#OrderLevel").val(),
                    RbId: $("#RbId").val(),
                    RbClPriority: $("#RbClPriority").val(),
                    Cancel: $("#Cancel").is(":checked") ? "T" : "F"
                },

                success: function(r) {
                    if (r.success) {
                        casePurposeGroupModal.hide();
                        location.reload();
                    } else {
                        alert(r.message);
                    }
                },
                error: function() {
                    alert("Save Failed");
                }
            });
        });

        // ── Delete Case Purpose Group ──────────────────────────
        $(document).on("click", ".delete", function() {
            if (!confirm("Are you sure want to delete?")) return;

            var id = $(this).data("id");

            $.ajax({
                url: '/CourtMaster/DeleteCasePurposeGroup',
                type: 'POST',
                data: {
                    id: id
                },
                success: function(r) {
                    if (r.success) {
                        location.reload();
                    }
                },
                error: function() {
                    alert("Delete Failed");
                }
            });
        });


    </script>
}