@model List<GCMS.Models.Entities.DepartmentMaster>

@{
    ViewData["Title"] = "Department Master";
    var srNo = 1;
}

<!-- ========== PAGE CONTAINER ========== -->
<div class="container-fluid bg-light rounded-4 m-auto shadow py-4 px-3">

    <!-- Header -->
    <div class="d-flex justify-content-between mb-3 border-bottom border-3 pb-3">

        <h4>Department Master</h4>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary" id="btnAddDepartment" title="Click to add new record.">
                Add Department
            </button>
            <button type="button" class="btn btn-secondary" id="btnPrint" title="Click to print.">
                <i class="bi bi-printer-fill"></i>
            </button>
            <button type="button" class="btn btn-success" id="btnExcel" title="Click to download excel.">
                <i class="bi bi-file-earmark-excel"></i>
            </button>
        </div>

    </div>
    <div class="table-responsive">
        <!-- Data Table -->
        <table id="tblDepartment" class="table table-bordered table-striped">

            <thead>
                <tr>
                    <td width="50">S. No.</td>
                    <th>Department Name</th>
                    <th>Department Name (In Hindi)</th>
                    <th>Court Code</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Active</th>
                    <th>Created By</th>
                    <th>Created On</th>
                    <th>Modified Date</th>
                    <th>Modified By</th>
                    <th width="180">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@srNo</td>
                        <td>@item.DepartmentName</td>
                        <td>@item.DepartmentNameHindi</td>
                        <td>@item.CourtCode</td>
                        <td>@item.Title</td>
                        <td>@item.Description</td>
                        <td>
                            @if (item.IsActive == "T")
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactive
                                </span>
                            }
                        </td>
                        <td>@item.CreatedBy</td>
                        <td>@item.CreatedOn</td>
                        <td>@item.ModifiedBy</td>
                        <td>@item.ModifiedOn</td>

                        <td>
                            <button type="button"
                                    class="btn btn-default waves-effect waves-light edit"
                                    data-id="@item.DepartmentId" title="Click to edit record.">
                                Edit
                            </button>
                        </td>
                    </tr>
                    srNo++;
                }
            </tbody>

        </table>
    </div>
</div>


<!-- ========== MODAL ========== -->
<div class="modal fade" id="departmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title">Department Master</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post">

                @Html.AntiForgeryToken()

                <!-- Modal Body -->
                <div class="modal-body">

                    <input type="hidden" id="DepartmentId" />

                    <div class="mb-3">
                        <label class="form-label">Department Name<span class="text-danger">*</span></label>
                        <input type="text" id="DepartmentName" class="form-control" />
                        <span class="text-danger" id="errDepartmentName"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Department Name (In Hindi)</label>
                        <input type="text" id="DepartmentNameHindi" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Court Code<span class="text-danger">*</span></label>
                        <input type="text" id="CourtCode" class="form-control" />
                        <span class="text-danger" id="errCourtCode"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input type="text" id="Title" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea id="Description" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="IsActive" checked>
                            <label class="form-check-label">Active</label>
                        </div>
                    </div>

                </div>

                <!-- Modal Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Close
                    </button>
                    <button type="button" class="btn btn-success" id="btnSave">
                        Save
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>


<!-- ========== SCRIPTS ========== -->
@section Scripts {
    <script>

        // ── Init ─────────────────────────────────────────────
        $(document).ready(function() {

            $('#tblDepartment').DataTable({

                dom: 'lBfrtip',
                responsive: true,
                autoWidth: false,
                pageLength: 10,
                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],
                paging: true,
                searching: true,
                ordering: true,
                info: true,

                columnDefs: [
                    { responsivePriority: 1, targets: 9 },
                    { responsivePriority: 2, targets: 0 }
                ],

                buttons: [
                    { extend: 'print', title: 'Department Master' },
                    { extend: 'excelHtml5', title: 'Department Master' }
                ]
            });

            $('.dt-buttons').hide();
        });

        $("#btnPrint").click(function() {
            window.print();
        });

        $("#btnExcel").click(function() {
            let table = document.getElementById("tblDepartment");
            let html = table.outerHTML;
            let url = 'data:application/vnd.ms-excel,' + encodeURIComponent(html);
            let a = document.createElement('a');
            a.href = url;
            a.download = 'DepartmentMaster.xls';
            a.click();
        });

        var departmentModal = new bootstrap.Modal(
            document.getElementById('departmentModal')
        );

        // ── Add Department ─────────────────────────────────────
        $("#btnAddDepartment").click(function() {
            $("#DepartmentId").val('');
            $("#DepartmentName").val('');
            $("#DepartmentNameHindi").val('');
            $("#CourtCode").val('');
            $("#Title").val('');
            $("#Description").val('');
            $("#errDepartmentName").text('');
            $("#errCourtCode").text('');
            $("#IsActive").prop("checked", true);
            departmentModal.show();
        });

        // ── Edit Department ─────────────────────────────────────
        $(document).on("click", ".edit", function() {
            var id = $(this).data("id");

            $.ajax({
                url: '/CourtMaster/GetDepartment',
                type: 'GET',
                data: { id: id },
                success: function(data) {

                    if (!data) {
                        alert("No data returned from server");
                        return;
                    }

                    $("#DepartmentId").val(data.departmentId);
                    $("#DepartmentName").val(data.departmentName);
                    $("#DepartmentNameHindi").val(data.departmentNameHindi);
                    $("#CourtCode").val(data.courtCode);
                    $("#Title").val(data.title);
                    $("#Description").val(data.description);
                    $("#IsActive").prop("checked", data.isActive === "T");
                    $("#errDepartmentName").text('');
                    $("#errCourtCode").text('');
                    departmentModal.show();
                },
                error: function() {
                    alert("Failed to load record");
                }
            });
        });

        // ── Save Department ─────────────────────────────────────
        $("#btnSave").click(function() {

            var token = $('input[name="__RequestVerificationToken"]').val();
            let isValid = true;

            $("#errDepartmentName").text('');
            $("#errCourtCode").text('');

            if ($("#DepartmentName").val().trim() === "") {
                $("#errDepartmentName").text("Department Name is required");
                isValid = false;
            }

            if ($("#CourtCode").val().trim() === "") {
                $("#errCourtCode").text("Court Code is required");
                isValid = false;
            }

            if (!isValid) return;

            $.ajax({
                url: '/CourtMaster/SaveDepartment',
                type: 'POST',
                headers: { RequestVerificationToken: token },
                data: {
                    DepartmentId: $("#DepartmentId").val(),
                    DepartmentName: $("#DepartmentName").val(),
                    DepartmentNameHindi: $("#DepartmentNameHindi").val(),
                    CourtCode: $("#CourtCode").val(),
                    Title: $("#Title").val(),
                    Description: $("#Description").val(),
                    IsActive: $("#IsActive").is(":checked") ? "T" : "F"
                },
                success: function(r) {
                    if (r.success) {
                        departmentModal.hide();
                        location.reload();
                    } else {
                        alert(r.message);
                    }
                },
                error: function() {
                    alert("Save Failed");
                }
            });
        });

        // ── Delete Department ────────────────────────────────────
        $(document).on("click", ".delete", function() {
            if (!confirm("Are you sure want to delete?")) return;

            var id = $(this).data("id");

            $.ajax({
                url: '/CourtMaster/DeleteDepartment',
                type: 'POST',
                data: { id: id },
                success: function(r) {
                    if (r.success) {
                        location.reload();
                    }
                },
                error: function() {
                    alert("Delete Failed");
                }
            });
        });

    </script>
}