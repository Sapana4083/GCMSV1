@model List<GCMS.Models.DesignationMaster>

@{
    ViewData["Title"] = "Designation Master";
    var srNo = 1;
}

<!-- ========== PAGE CONTAINER ========== -->
<div class="container-fluid bg-light rounded-4 m-auto shadow mt-3 py-4 px-3">

    <!-- Header -->
    <div class="d-flex justify-content-between mb-3 border-bottom border-3 pb-3">

        <h4>Designation Master</h4>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary" id="btnAddDesignation" title="Click to add new record.">
                Add Designation
            </button>
            <button type="button" class="btn btn-secondary" id="btnPrint" title="Click to print.">
                <i class="bi bi-printer-fill"></i>
            </button>
            <button type="button" class="btn btn-success" id="btnExcel" title="Click to download excel.">
                <i class="bi bi-file-earmark-excel"></i>
            </button>
        </div>

    </div>
    <div class="table-responsive">
        <!-- Data Table -->
        <table id="tblDesignation" class="table table-bordered table-striped">

            <thead>
                <tr>
                    <td width="50">S. No.</td>
                    <th>Designation Name</th>
                    <th>Designation Name Hindi</th>
                    <th>Designation Code</th>
                    <th>Active</th>
                    <th>Created By</th>
                    <th>Modified Date</th>

                    <th width="180">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@srNo</td>
                        <td>@item.DesgName</td>
                        <td>@item.DesgNameHi</td>
                        <td>@item.DesgCode</td>
                        <td>

                        
                            @if (item.InCative == "F")
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactive
                                </span>
                            }

                        </td>
                        <td>@item.CreatedBy</td>
                        <td>@item.ModifiedOn</td>

                        <td>
                            <button type="button"
                                    class="btn btn-default waves-effect waves-light edit"
                                    data-id="@item.CmRcsatDesignTmpId" title="Click to edit record.">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                        </td>
                    </tr>
                    srNo++;
                }
            </tbody>

        </table>
    </div>
</div>


<!-- ========== MODAL ========== -->
<div class="modal fade" id="designationModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title">Designation Master</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post">

                @Html.AntiForgeryToken()

                <!-- Modal Body -->
                <div class="modal-body">

                    <input type="hidden" id="CmRcsatDesignTmpId" />

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Designation Name<span class="text-danger">*</span></label>
                            <input type="text" id="DesgName" class="form-control" />
                            <span class="text-danger" id="errDesgName"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label">Designation Name Hindi<span class="text-danger">*</span></label>
                            <input type="text" id="DesgNameHi" class="form-control" />
                            <span class="text-danger" id="errDesgNameHi"></span>
                        </div>

                      @* <div class="col-md-4 mb-3">
                            <label class="form-label">Designation Code</label>
                            <input type="text" id="DesgCode" class="form-control" readonly />
                        </div>  *@

                        <div class="col-md-4 mb-3">
                            <label class="form-label">In Active</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="InActive">
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Modal Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Close
                    </button>
                    <button type="button" class="btn btn-success" id="btnSave">
                        Save
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>


<!-- ========== SCRIPTS ========== -->
@section Scripts {
    <script>

        // ── Init ─────────────────────────────────────────────
        $(document).ready(function() {

            $('#tblDesignation').DataTable({

                dom: 'lBfrtip',

                responsive: true,
                autoWidth: false,

                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],

                paging: true,
                searching: true,
                ordering: true,
                info: true,

                columnDefs: [{
                    responsivePriority: 1,
                    targets: 7
                },
                {
                    responsivePriority: 2,
                    targets: 0
                }
                ],

                buttons: [{
                    extend: 'print',
                    title: 'Designation Master'
                },
                {
                    extend: 'excelHtml5',
                    title: 'Designation Master'
                }
                ]
            });

            $('.dt-buttons').hide();
        });
        $("#btnPrint").click(function() {

            window.print();

        });

        $("#btnExcel").click(function() {

            let table = document.getElementById("tblDesignation");

            let html = table.outerHTML;

            let url = 'data:application/vnd.ms-excel,' +
                encodeURIComponent(html);

            let a = document.createElement('a');

            a.href = url;
            a.download = 'DesignationMaster.xls';

            a.click();

        });

        var designationModal = new bootstrap.Modal(
            document.getElementById('designationModal')
        );

        // ── Add Designation ─────────────────────────────────────
        $("#btnAddDesignation").click(function() {
            $("#CmRcsatDesignTmpId").val('');
            $("#DesgName").val('');
            $("#DesgNameHi").val('');
            $("#DesgCode").val('');
            $("#errDesgName").text('');
            $("#errDesgNameHi").text('');
            $("#InActive").prop("checked", false);
            designationModal.show();
        });

        

        // ── Edit Designation ────────────────────────────────────
        $(document).on("click", ".edit", function() {
            var id = $(this).data("id");

            $.ajax({
                url: '/CourtMaster/GetDesignation',
                type: 'GET',
                data: {
                    id: id
                },
                success: function(data) {

                    console.log(data);

                    if (!data) {
                        alert("No data returned from server");
                        return;
                    }

                    $("#CmRcsatDesignTmpId").val(data.cmRcsatDesignTmpId);
                    $("#DesgName").val(data.desgName);
                    $("#DesgNameHi").val(data.desgNameHi);
                    $("#DesgCode").val(data.desgCode);
                    $("#InActive").prop(
                        "checked",
                        data.InActive === "1"
                    );
                    $("#errDesgName").text('');
                    $("#errDesgNameHi").text('');
                    designationModal.show();
                }
            });
        });

        // ── Save Designation ────────────────────────────────────
        $("#btnSave").click(function() {

            var token = $('input[name="__RequestVerificationToken"]').val();
            let isValid = true;

            $("#errDesgName").text('');
            $("#errDesgNameHi").text('');

            if ($("#DesgName").val().trim() === "") {
                $("#errDesgName").text("Designation Name is required");
                isValid = false;
            }

            if ($("#DesgNameHi").val().trim() === "") {
                $("#errDesgNameHi").text("Designation Name Hindi is required");
                isValid = false;
            }

            if (!isValid)
                return;

            
            $.ajax({
                url: '/CourtMaster/SaveDesignation',
                type: 'POST',
                headers: {
                    RequestVerificationToken: token
                },
                data: {
                    CmRcsatDesignTmpId: $("#CmRcsatDesignTmpId").val() || 0,
                    DesgName: $("#DesgName").val(),
                    DesgNameHi: $("#DesgNameHi").val(),
                    InActive: $("#InActive").is(":checked") ? "1" : "0"
                },

                success: function(r) {
                    if (r.success) {
                        designationModal.hide();
                        location.reload();
                    } else {
                        alert(r.message);
                    }
                },
                error: function() {
                    alert("Save Failed");
                }
            });
        });

    </script>
}