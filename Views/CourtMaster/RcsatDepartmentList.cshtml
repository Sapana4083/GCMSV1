@model List<GCMS.Models.RcsatDepartmentMaster>

@{
    ViewData["Title"] = "RCSAT Department Master";
    var srNo = 1;
}

<!-- ========== PAGE CONTAINER ========== -->
<div class="container-fluid bg-light rounded-4 m-auto shadow mt-3 py-4 px-3">

    <!-- Header -->
    <div class="d-flex justify-content-between mb-3 border-bottom border-3 pb-3">

        <h4>RCSAT Department Master</h4>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary" id="btnAddRcsatDepartment" title="Click to add new record.">
                Add Department
            </button>
            <button type="button" class="btn btn-secondary" id="btnPrint" title="Click to print.">
                <i class="bi bi-printer-fill"></i>
            </button>
            <button type="button" class="btn btn-success" id="btnExcel" title="Click to download excel.">
                <i class="bi bi-file-earmark-excel"></i>
            </button>
        </div>

    </div>
    <div class="table-responsive">
        <!-- Data Table -->
        <table id="tblRcsatDepartment" class="table table-bordered table-striped">

            <thead>
                <tr>
                    <td width="50">S. No.</td>
                    <th>Department Name (English)</th>
                    <th>Active</th>

                    <th width="100">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@srNo</td>
                        <td>@item.DepEngHi</td>
                        <td>

                        
                            @if (item.InActive == "F")
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactive
                                </span>
                            }

                        </td>

                        <td>
                            <button type="button"
                                    class="btn btn-default waves-effect waves-light edit"
                                    data-id="@item.CmRcsatDeptId" title="Click to edit record.">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                        </td>
                    </tr>
                    srNo++;
                }
            </tbody>

        </table>
    </div>
</div>


<!-- ========== MODAL ========== -->
<div class="modal fade" id="rcsatDepartmentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title">RCSAT Department Master</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post">

                @Html.AntiForgeryToken()

                <!-- Modal Body -->
                <div class="modal-body">

                    <input type="hidden" id="CmRcsatDeptId" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Department Name in English<span class="text-danger">*</span></label>
                            <input type="text" id="DeptName" class="form-control" />
                            <span class="text-danger" id="errDeptName"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Department Name in Hindi</label>
                            <input type="text" id="DeptNameHi" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Title</label>
                            <input type="text" id="DepEngHi" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>
                            <input type="text" id="Email" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Is Active</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="InActive">
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Modal Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Close
                    </button>
                    <button type="button" class="btn btn-success" id="btnSave">
                        Save
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>


<!-- ========== SCRIPTS ========== -->
@section Scripts {
    <script>

        // ── Init ─────────────────────────────────────────────
        $(document).ready(function() {

            $('#tblRcsatDepartment').DataTable({

                dom: 'lBfrtip',

                responsive: true,
                autoWidth: false,

                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],

                paging: true,
                searching: true,
                ordering: true,
                info: true,

                buttons: [{
                    extend: 'print',
                    title: 'RCSAT Department Master'
                },
                {
                    extend: 'excelHtml5',
                    title: 'RCSAT Department Master'
                }
                ]
            });

            $('.dt-buttons').hide();
        });
        $("#btnPrint").click(function() {

            window.print();

        });

        $("#btnExcel").click(function() {

            let table = document.getElementById("tblRcsatDepartment");

            let html = table.outerHTML;

            let url = 'data:application/vnd.ms-excel,' +
                encodeURIComponent(html);

            let a = document.createElement('a');

            a.href = url;
            a.download = 'RcsatDepartmentMaster.xls';

            a.click();

        });

        var rcsatDepartmentModal = new bootstrap.Modal(
            document.getElementById('rcsatDepartmentModal')
        );

        // ── Add ─────────────────────────────────────
        $("#btnAddRcsatDepartment").click(function() {
            $("#CmRcsatDeptId").val('');
            $("#DeptName").val('');
            $("#DeptNameHi").val('');
            $("#DepEngHi").val('');
            $("#Email").val('');
            $("#errDeptName").text('');
            $("#InActive").prop("checked", false);
            rcsatDepartmentModal.show();
        });

        

        // ── Edit ────────────────────────────────────
        $(document).on("click", ".edit", function() {
            var id = $(this).data("id");

            $.ajax({
                url: '/CourtMaster/GetRcsatDepartment',
                type: 'GET',
                data: {
                    id: id
                },
                success: function(data) {

                    console.log(data);

                    if (!data) {
                        alert("No data returned from server");
                        return;
                    }

                    $("#CmRcsatDeptId").val(data.cmRcsatDeptId);
                    $("#DeptName").val(data.deptName);
                    $("#DeptNameHi").val(data.deptNameHi);
                    $("#DepEngHi").val(data.depEngHi);
                    $("#InActive").prop(
                        "checked",
                        data.inActive === "T"
                    );
                    $("#errDeptName").text('');
                    rcsatDepartmentModal.show();
                }
            });
        });

        // ── Save ────────────────────────────────────
        $("#btnSave").click(function() {

            var token = $('input[name="__RequestVerificationToken"]').val();
            let isValid = true;

            $("#errDeptName").text('');

            if ($("#DeptName").val().trim() === "") {
                $("#errDeptName").text("Department Name in English is required");
                isValid = false;
            }

            if (!isValid)
                return;

            
            $.ajax({
                url: '/CourtMaster/SaveRcsatDepartment',
                type: 'POST',
                headers: {
                    RequestVerificationToken: token
                },
                data: {
                    CmRcsatDeptId: $("#CmRcsatDeptId").val() || 0,
                    DeptName: $("#DeptName").val(),
                    DeptNameHi: $("#DeptNameHi").val(),
                    DepEngHi: $("#DepEngHi").val(),
                    Email: $("#Email").val(),
                    InActive: $("#InActive").is(":checked") ? "T" : "F"
                },

                success: function(r) {
                    if (r.success) {
                        rcsatDepartmentModal.hide();
                        location.reload();
                    } else {
                        alert(r.message);
                    }
                },
                error: function() {
                    alert("Save Failed");
                }
            });
        });

    </script>
}