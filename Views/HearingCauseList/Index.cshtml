@model GCMS.Models.ViewModels.HearingCauseListViewModel

@{
    ViewData["Title"] = "Multiple Hearing Cause List";
    var privateAdvocateOptionsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.PrivateAdvocates.Select(x => new { value = x.Value, text = x.Text }));
}

<!-- ========== PAGE CONTAINER ========== -->
<div class="container-fluid bg-light rounded-4 m-auto shadow py-4 px-3 mt-3">

    @Html.AntiForgeryToken()

    <!-- Header -->
    <div class="d-flex justify-content-between mb-3 border-bottom border-3 pb-3">

        <h4>Multiple Hearing Cause List</h4>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary" id="btnPrint" title="Click to print.">
                <i class="bi bi-printer-fill"></i>
            </button>
            <button type="button" class="btn btn-success" id="btnExcel" title="Click to download excel.">
                <i class="bi bi-file-earmark-excel"></i>
            </button>
        </div>

    </div>

    <!-- ========== FILTER SECTION ========== -->
    <div class="row mb-3">
        <div class="col-md-4 mb-3">
            <label asp-for="HearingDate" class="form-label"></label>
            <input asp-for="HearingDate" type="date" class="form-control" id="hearingDate" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="BenchNo" class="form-label"></label>
            <select asp-for="BenchNo" asp-items="Model.BenchTypes" class="form-select" id="benchTypeId">
                <option value="">Select Bench</option>
            </select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="CauseListType" class="form-label"></label>
            <select asp-for="CauseListType" asp-items="Model.CauseListTypes" class="form-select" id="causeListType"></select>
        </div>
    </div>

    <!-- ========== TABLE ========== -->
    <div class="table-responsive">
        <table id="tblHearingCauseList" class="table table-bordered table-striped dataTable no-footer dtr-inline">

            <thead>
                <tr>
                    <td class="sorting" width="50">S. No.</td>
                    <th class="sorting">Case Number</th>
                    <th class="sorting">Parent Case No</th>
                    <th class="sorting">Purpose</th>
                    <th class="sorting">Hearing Date</th>
                    <th class="sorting">Appellant Name</th>
                    <th class="sorting">Advocate Name</th>
                    <th class="sorting">Is Stay</th>
                    <th class="sorting">Is Reply</th>

                    <th width="100">Action</th>
                </tr>
            </thead>

            <tbody id="hearingCauseRows"></tbody>

        </table>
    </div>

</div>


<!-- ========== EDIT MODAL ========== -->
<div class="modal fade" id="hearingEditModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Edit Hearing Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="modalCaseId" />
                <input type="hidden" id="modalCauseListId" />
                <input type="hidden" id="modalTcsatMultHerId" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Case Number</label>
                        <input type="text" class="form-control" id="modalCaseNumber" readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Appellant Name</label>
                        <input type="text" class="form-control" id="modalAppellantName" readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Advocate Name</label>
                        <input type="text" class="form-control" id="modalAdvocateName" readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Hearing Date</label>
                        <input type="date" class="form-control" id="modalHearingDate" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Purchase Date</label>
                        <input type="date" class="form-control" id="modalPurchaseDate" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Is Stay</label>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="modalIsStay" />
                        </div>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Stay Date</label>
                        <input type="date" class="form-control" id="modalStayDate" disabled />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Is Reply</label>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="modalIsReply" />
                        </div>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Reply Date</label>
                        <input type="date" class="form-control" id="modalReplyDate" disabled />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label">Private Advocate Name</label>
                        <select class="form-select" id="modalPrivateAdvocateId">
                            <option value="">Select an option</option>
                        </select>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" id="btnSaveRow">Save</button>
            </div>

        </div>
    </div>
</div>


<!-- ========== SCRIPTS ========== -->
@section Scripts {
    <script>
        $(function () {
            var $rows = $("#hearingCauseRows");
            var privateAdvocateOptions = @Html.Raw(privateAdvocateOptionsJson);
            var currentRows = [];
            var hearingModal = new bootstrap.Modal(document.getElementById('hearingEditModal'));
            var hearingDataTable = null;

            function formatDate(value) {
                if (!value) return "";
                return String(value).slice(0, 10);
            }

            function escapeHtml(value) {
                return String(value || "")
                    .replace(/&/g, "&amp;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#39;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;");
            }

            function buildRow(row, index) {
                var isStay = row.isStay === true || String(row.isStay).toLowerCase() === "true";
                var isReply = row.isReply === true || String(row.isReply).toLowerCase() === "true";

                return '<tr data-index="' + index + '">'
                    + '<td>' + (index + 1) + '</td>'
                    + '<td>' + escapeHtml(row.caseNumber) + '</td>'
                    + '<td>' + escapeHtml(row.parentCaseNumber) + '</td>'
                    + '<td>' + escapeHtml(row.purpose) + '</td>'
                    + '<td>' + formatDate(row.hearingDate) + '</td>'
                    + '<td>' + escapeHtml(row.appellantName) + '</td>'
                    + '<td>' + escapeHtml(row.advocateName) + '</td>'
                    + '<td>' + (isStay ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-secondary">No</span>') + '</td>'
                    + '<td>' + (isReply ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-secondary">No</span>') + '</td>'
                    + '<td>'
                    + '<button type="button" class="btn btn-default waves-effect waves-light edit-row" data-index="' + index + '" title="Click to edit record.">'
                    + '<i class="bi bi-pencil-square"></i>'
                    + '</button>'
                    + '</td>'
                    + '</tr>';
            }

            function initDataTable() {
                if (hearingDataTable) {
                    hearingDataTable.destroy();
                    hearingDataTable = null;
                }

                hearingDataTable = $('#tblHearingCauseList').DataTable({
                    dom: 'lBfrtip',
                    responsive: true,
                    autoWidth: false,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    paging: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    buttons: [
                        { extend: 'print', title: 'Multiple Hearing Cause List' },
                        { extend: 'excelHtml5', title: 'Multiple Hearing Cause List' }
                    ]
                });

                $('.dt-buttons').hide();
            }

            function renderTable() {
                if (hearingDataTable) {
                    hearingDataTable.destroy();
                    hearingDataTable = null;
                }

                if (currentRows.length === 0) {
                    $rows.html('<tr><td colspan="10" class="text-center text-muted py-4">No hearing cause list found.</td></tr>');
                    return;
                }

                $rows.html(currentRows.map(buildRow).join(""));
                initDataTable();
            }

            function loadCauseList() {
                var hearingDate = $("#hearingDate").val();
                var benchTypeId = $("#benchTypeId").val();

                if (!hearingDate || !benchTypeId) {
                    currentRows = [];
                    if (hearingDataTable) {
                        hearingDataTable.destroy();
                        hearingDataTable = null;
                    }
                    $rows.html('<tr><td colspan="10" class="text-center text-muted py-4">Select hearing date, bench no and cause list type.</td></tr>');
                    return;
                }

                $.getJSON("/HearingCauseList/GetHearingCauseList", {
                    hearingDate: hearingDate,
                    benchTypeId: benchTypeId,
                    causeListType: $("#causeListType").val()
                }).done(function (data) {
                    currentRows = data || [];
                    renderTable();
                }).fail(function () {
                    alert("Unable to load hearing cause list.");
                });
            }

            $("#hearingDate, #benchTypeId, #causeListType").on("change", loadCauseList);

            $("#btnPrint").on("click", function () {
                window.print();
            });

            // ── Open Edit Modal ───────────────────────────────
            $(document).on("click", ".edit-row", function () {
                var index = $(this).data("index");
                var row = currentRows[index];
                if (!row) return;

                var isStay = row.isStay === true || String(row.isStay).toLowerCase() === "true";
                var isReply = row.isReply === true || String(row.isReply).toLowerCase() === "true";

                $("#modalCaseId").val(row.caseId);
                $("#modalCauseListId").val(row.causeListId);
                $("#modalTcsatMultHerId").val(row.tcsatMultHerId);

                $("#modalCaseNumber").val(row.caseNumber);
                $("#modalAppellantName").val(row.appellantName);
                $("#modalAdvocateName").val(row.advocateName);
                $("#modalHearingDate").val(formatDate(row.hearingDate));
                $("#modalPurchaseDate").val(formatDate(row.purchaseDate));

                $("#modalIsStay").prop("checked", isStay);
                $("#modalStayDate").prop("disabled", !isStay).val(isStay ? formatDate(row.stayDate) : "");

                $("#modalIsReply").prop("checked", isReply);
                $("#modalReplyDate").prop("disabled", !isReply).val(isReply ? formatDate(row.replyDate) : "");

                       var options = '<option value="">Select an option</option>';
        privateAdvocateOptions.forEach(function (adv) {
            var selected = String(adv.value) === String(row.privateAdvocateName || "") ? " selected" : "";
            options += '<option value="' + escapeHtml(adv.value) + '"' + selected + '>' + escapeHtml(adv.text) + '</option>';
        });
        $("#modalPrivateAdvocateId").html(options);

                $("#hearingEditModal").data("row-index", index);
                hearingModal.show();
            });

            $("#modalIsStay").on("change", function () {
                var checked = $(this).is(":checked");
                $("#modalStayDate").prop("disabled", !checked);
                if (!checked) $("#modalStayDate").val("");
            });

            $("#modalIsReply").on("change", function () {
                var checked = $(this).is(":checked");
                $("#modalReplyDate").prop("disabled", !checked);
                if (!checked) $("#modalReplyDate").val("");
            });

                   $("#btnSaveRow").on("click", function () {

            var rowData = {
                causeListId: Number($("#modalCauseListId").val()) || 0,
                tcsatMultHerId: Number($("#modalTcsatMultHerId").val()) || 0,
                caseId: Number($("#modalCaseId").val()),
                hearingDate: $("#modalHearingDate").val() || null,
                stayDate: $("#modalStayDate").val() || null,
                replyDate: $("#modalReplyDate").val() || null,
                purchaseDate: $("#modalPurchaseDate").val() || null,
                isStay: $("#modalIsStay").is(":checked"),
                isReply: $("#modalIsReply").is(":checked"),
                privateAdvocateName: $("#modalPrivateAdvocateId").val() || null   // ✅ Number() hataya, naam string bhej rahe hain
            };

            $.ajax({
                url: "/HearingCauseList/SaveRows",
                method: "POST",
                contentType: "application/json",
                headers: {
                    RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify({
                    hearingDate: $("#hearingDate").val() || null,
                    benchNo: $("#benchTypeId").val() || null,
                    causeListType: $("#causeListType").val() || null,
                    rows: [rowData]
                })
            }).done(function (response) {
                if (response.success) {
                    hearingModal.hide();
                    loadCauseList();
                } else {
                    alert(response.message || "Save failed.");
                }
            }).fail(function () {
                alert("Unable to save hearing cause list.");
            });
        });

            if ($("#hearingDate").val() && $("#benchTypeId").val()) {
                loadCauseList();
            }
        });
    </script>
}