@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GCMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link href="~/css/jquery.datatables.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebarstylesheet.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/GCMS.styles.css" asp-append-version="true" />
    <link href="~/lib/bootstrap-icon/font/bootstrap-icons-new.css" rel="stylesheet" />

    @* Third Party  *@
    <link href="~/thirdparty/css/buttons.datatables.min.css" rel="stylesheet" />
    <link href="~/thirdparty/css/responsive.datatables.min.css" rel="stylesheet" />
    <link href="~/css/all.min.css" rel="stylesheet" />

   @*  <link rel="stylesheet"
          href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css" />
    <link rel="stylesheet"
          href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"> *@

    <style>
        :root {
            --gcms-navy: #0f2447;
            --gcms-blue: #185fa5;
            --gcms-blue2: #378add;
            --gcms-gold: #c99a3d;
        }

        /* Logo relocated into accessibility bar */
        .topbar-brand {
            display: flex;
            align-items: center;
        }

            .topbar-brand img {
                height: 67px;
                width: auto;
            }

        /* ---------- Accessibility bar ---------- */
        .accessibility-bar {
            /* background: #f4f7fb; */
            border-bottom: 1px solid #e2e8f0;
            background: #f7f7f7;
           /*  background: #ffffff;
            background: linear-gradient(90deg,rgba(255, 255, 255, 1) 27%, rgba(235, 241, 245, 1) 82%, rgba(240, 249, 255, 1) 100%); */
        }

            .accessibility-bar .accessibility-label {
                color: #33424f;
                font-size: 0.78rem;
               /*  color: #ffffff;
                font-size: 0.98rem; */

            }

            .accessibility-bar .a11y-btn {
                background: #fff;
                border: 1px solid #dde3ea;
                /* color: #33424f; */
                color: #000000;
                border-radius: 6px;
                font-size: 0.76rem;
                padding: 4px 10px;
                transition: background 0.2s ease, border-color 0.2s ease;
            }

                .accessibility-bar .a11y-btn:hover,
                .accessibility-bar .a11y-btn[aria-pressed="true"] {
                    background: #eaf1fb;
                    border-color: var(--gcms-blue2);
                }

            .accessibility-bar .accessibility-divider {
                color: #c3ccd4;
            }

        .accessibility-divider-logo {
            color: #3d7cb3;
            height: 100% !important;
            width: 1%;
            font-size: 31px;
            margin-right: -10px;
            }

        /* User dropdown pill */
        .user-menu-toggle {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #eaf1fb;
            border: 1px solid #d3e6f7;
            border-radius: 20px;
            padding: 5px 14px 5px 6px;
            cursor: pointer;
            transition: background 0.2s ease;
        }

            .user-menu-toggle:hover {
                background: #dcebfa;
            }

            .user-menu-toggle::after {
                display: none;
            }

        .user-avatar-square {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--gcms-blue);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .user-avatar-square svg {
                width: 15px;
                height: 15px;
            }

       /*  .user-name {
            font-size: 0.75rem;
            font-weight: 700;
            color: #0c3e6f;
            /* text-transform: capitalize; */
            text-transform: uppercase;
        } */

        .user-dropdown-menu {
            border: 1px solid #e7ebf0;
            border-radius: 10px;
            box-shadow: 0 12px 28px rgba(15,36,71,0.14);
            padding: 6px 0;
            margin-top: 8px !important;
        }

            .user-dropdown-menu .dropdown-header {
                padding: 10px 16px 6px 16px;
            }

        .dropdown-user-name {
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--gcms-navy);
        }

        .dropdown-user-role {
            font-size: 0.75rem;
            color: #888;
            margin-top: 2px;
        }

        .user-dropdown-menu .dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 16px;
            font-size: 0.87rem;
        }

            .user-dropdown-menu .dropdown-item:hover {
                background: #f4f8fb;
            }

        /* ---------- Topbar ---------- */
        .topbar {
            position: fixed;
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 14px 22px;
            /* background: #132c52; */
            /* background: #354c71; */
            /* background: #5c85c7; */
            background: #ffffff;
            box-shadow: 0 2px 10px rgba(15,36,71,0.08);
        }

            .topbar::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, var(--gcms-blue), var(--gcms-blue2), var(--gcms-gold));
            }

            .topbar .sidebar-toggle-desktop,
            .topbar .sidebar-toggle-mobile {
                background: #eaf1fb;
                border: 1px solid #d3e6f7;
                color: var(--gcms-blue);
                border-radius: 8px;
                width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: background 0.2s ease;
            }

                .topbar .sidebar-toggle-desktop:hover,
                .topbar .sidebar-toggle-mobile:hover {
                    background: #dcebfa;
                }

        .topbar-title.deepshadow {
            /* flex: 1; */
            text-align: center;
           
            color: #0e569d;
            font-size: 1.3rem;
            font-weight: 600;
            letter-spacing: 0.3px;
            text-shadow: none;
           
            padding-right: 16%;
        }

        .mainlogo{
            /* width: 107%;
            margin-left: -17px; */
            width: 165px;
        }
    </style>
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <a href="#mainContent" class="skip-to-content">Skip to main content</a>

    <div class="accessibility-bar" role="region" aria-label="Accessibility options">
        <div class="container-fluid d-flex justify-content-between align-items-center gap-2 py-1">

            <div class="topbar-brand">
                
                @* <img src="~/images/rajasthan-sarkar-logo.png" class="me-5" /> *@
                <img src="~/images/mainlogo/logo.png" class="topbarimg" />
               
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="accessibility-label">Text Size:</span>
                <button type="button" class="a11y-btn" id="fontDecrease" aria-label="Decrease text size">A-</button>
                <button type="button" class="a11y-btn" id="fontReset" aria-label="Reset text size">A</button>
                <button type="button" class="a11y-btn" id="fontIncrease" aria-label="Increase text size">A+</button>

                <span class="accessibility-divider" aria-hidden="true">|</span>

                <button type="button" class="a11y-btn" id="contrastToggle" aria-pressed="false">
                    High Contrast
                </button>

                <button type="button" class="a11y-btn" id="spacingToggle" aria-pressed="false">
                    Text Spacing
                </button>

                <!-- User dropdown - right corner -->
                <div class="user-menu dropdown">
                    <button class="user-menu-toggle dropdown-toggle" type="button" id="userMenuButton"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="user-avatar-square">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 12c2.7 0 4.9-2.2 4.9-4.9S14.7 2.2 12 2.2 7.1 4.4 7.1 7.1 9.3 12 12 12zm0 2.4c-3.3 0-9.8 1.6-9.8 4.9v2.5h19.6v-2.5c0-3.3-6.5-4.9-9.8-4.9z" />
                            </svg>
                        </span>
                        <span class="user-name">@(Context.Session.GetString("Username") ?? "N/A")</span>
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu" aria-labelledby="userMenuButton">
                        <li class="dropdown-header">
                            <div class="dropdown-user-name">@ViewBag.UserName</div>
                            <div class="dropdown-user-role">@ViewBag.UserRole</div>
                        </li>
                        <li>
                            <a class="dropdown-item text-dark" href="https://sso.rajasthan.gov.in/signin">
                                <i class="fa-solid fa-circle-arrow-left"></i> Back To SSO
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" href="/Account/Logout" id="logoutLink">
                                <i class="fa-solid fa-right-from-bracket"></i> Logout
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </div>

    <div class="d-flex" id="wrapper">

        <!-- Dynamic Sidebar -->
        @await Component.InvokeAsync("Sidebar")

        <!-- Sidebar Overlay -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Content Area -->
        <div class="content-area" id="contentArea">

            <header class="topbar">

                <button class="sidebar-toggle-desktop"
                        id="sidebarToggle"
                        type="button">
                    <i class="bi bi-list"></i>
                </button>

                <button class="sidebar-toggle-mobile"
                        id="sidebarToggleMobile"
                        type="button">
                    <i class="bi bi-list"></i>
                </button>

                @* <img src="~/images/rcsatimg.jpeg" alt="GCMS Logo" class="mainlogo" /> *@
                <img src="~/images/mainlogo/gcms_blue.png" alt="GCMS Logo" class="mainlogo" />
                <span class="accessibility-divider-logo" aria-hidden="true">|</span>
                <span class="topbar-title deepshadow text-end">
                    @(Context.Session.GetString("CourtName") ?? "N/A")
                </span>

            </header>

            <main id="mainContent"
                  role="main"
                  class="pb-3"
                  tabindex="-1">

                @RenderBody()

            </main>

        </div>

    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/jquery.datatables.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/sidebarjavascript.js" asp-append-version="true"></script>
    <script src="~/js/accessibility.js" asp-append-version="true"></script>
  
@*  <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
   <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script> 
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script> *@


